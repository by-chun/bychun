diff --git a/lib/widgets/tree_drawer.dart b/lib/widgets/tree_drawer.dart
index fd90535..772a63d 100644
--- a/lib/widgets/tree_drawer.dart
+++ b/lib/widgets/tree_drawer.dart
@@ -226,7 +226,35 @@ class _TreeDrawerState extends ConsumerState<TreeDrawer> {
       return;
     }
     if (act == 'import') {
-      _toast('用终端 cp 或直接把文件拖进对话让 AI 放进该目录');
+      // 选一个文本文件，写入当前目录（名字可改）
+      final content = await NativeBridge.pickTextFile();
+      if (content == null || content.isEmpty || !mounted) return;
+      final c = TextEditingController();
+      final ok = await showDialog<bool>(
+        context: context,
+        builder: (ctx) => AlertDialog(
+          backgroundColor: Colors.white,
+          title: const Text('导入文件名', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+          content: Column(mainAxisSize: MainAxisSize.min, crossAxisAlignment: CrossAxisAlignment.start, children: [
+            Text('存到 $dir',
+                style: const TextStyle(fontSize: 10, color: Color(0xFF94A3B8), fontFamily: 'monospace')),
+            const SizedBox(height: 8),
+            TextField(controller: c, autofocus: true),
+          ]),
+          actions: [
+            TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+            FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('导入')),
+          ],
+        ),
+      );
+      final name = c.text.trim();
+      c.dispose();
+      if (ok != true || name.isEmpty) return;
+      final safeName = name.replaceAll("'", "'\\''");
+      final safeBody = content.replaceAll("'", "'\\''");
+      await NativeBridge.exec("printf '%s' '$safeBody' > '$dir/$safeName'");
+      _dirs.clear();
+      if (mounted) setState(() {});
       return;
     }
     final c = TextEditingController();
diff --git a/pubspec.yaml b/pubspec.yaml
index 01fa781..84700cb 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: 'none' # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
