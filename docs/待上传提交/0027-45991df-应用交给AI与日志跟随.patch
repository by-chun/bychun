+  /// 选一个已安装应用，把它的 APK 路径交给 AI（不用传大文件）。
+  Future<void> _pickApp() async {
+    final apps = await NativeBridge.listApps();
+    if (!mounted) return;
+    final picked = await showModalBottomSheet<Map<String, dynamic>>(
+      context: context,
+      backgroundColor: Colors.white,
+      isScrollControlled: true,
+      shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
+      builder: (ctx) {
+        var q = '';
+        return StatefulBuilder(
+          builder: (ctx, setD) {
+            final list = q.isEmpty
+                ? apps
+                : apps.where((a) {
+                    final l = (a['label'] ?? '').toString().toLowerCase();
+                    final p = (a['package'] ?? '').toString().toLowerCase();
+                    return l.contains(q.toLowerCase()) || p.contains(q.toLowerCase());
+                  }).toList();
+            return SafeArea(
+              child: SizedBox(
+                height: MediaQuery.of(ctx).size.height * 0.6,
+                child: Column(children: [
+                  const Padding(
+                    padding: EdgeInsets.fromLTRB(18, 16, 18, 8),
+                    child: Align(
+                      alignment: Alignment.centerLeft,
+                      child: Text('选一个应用交给 AI',
+                          style: TextStyle(fontSize: 13.5, fontWeight: FontWeight.w800)),
+                    ),
+                  ),
+                  Padding(
+                    padding: const EdgeInsets.symmetric(horizontal: 16),
+                    child: TextField(
+                      onChanged: (v) => setD(() => q = v),
+                      decoration: const InputDecoration(
+                        isDense: true,
+                        prefixIcon: Icon(Icons.search_rounded, size: 18),
+                        hintText: '搜索应用名 / 包名',
+                      ),
+                    ),
+                  ),
+                  const SizedBox(height: 6),
+                  Expanded(
+                    child: ListView.builder(
+                      itemCount: list.length,
+                      itemBuilder: (_, i) {
+                        final a = list[i];
+                        return ListTile(
+                          dense: true,
+                          leading: AppIcon(app: a, size: 28),
+                          title: Text((a['label'] ?? '').toString(),
+                              style: const TextStyle(fontSize: 12.5)),
+                          subtitle: Text((a['package'] ?? '').toString(),
+                              style: const TextStyle(fontSize: 9.5, fontFamily: 'monospace')),
+                          onTap: () => Navigator.pop(ctx, a),
+                        );
+                      },
+                    ),
+                  ),
+                ]),
+              ),
+            );
+          },
+        );
+      },
+    );
+    if (picked == null || !mounted) return;
+    ref.read(chatRefsProvider.notifier).add(ChatRef(
+          type: 'app',
+          name: (picked['label'] ?? '').toString(),
+          detail: '${picked['package']}\nAPK: ${picked['apk']}',
+        ));
+    setState(() => _showAttach = false);
+  }
+
