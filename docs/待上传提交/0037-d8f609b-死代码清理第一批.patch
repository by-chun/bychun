diff --git a/lib/agent/skills.dart b/lib/agent/skills.dart
deleted file mode 100644
index 063037e..0000000
--- a/lib/agent/skills.dart
+++ /dev/null
@@ -1,71 +0,0 @@
-import 'dart:convert';
-import 'dart:io';
-import '../native/native_bridge.dart';
-
-class Skill {
-  final String name;
-  final String description;
-  final String body;
-  const Skill(this.name, this.description, this.body);
-}
-
-/// 技能管理：从 filesDir/skills 下每个子目录的 SKILL.md 读取（frontmatter 可带 description）。
-class SkillManager {
-  final List<Skill> _skills = [];
-
-  List<Skill> get all => List.unmodifiable(_skills);
-
-  void add(Skill s) => _skills.add(s);
-
-  void remove(String name) => _skills.removeWhere((s) => s.name == name);
-
-  Future<void> load() async {
-    _skills.clear();
-    final dir = await NativeBridge.appDataDir();
-    if (dir.isEmpty) return;
-    final root = Directory('$dir/skills');
-    if (!await root.exists()) return;
-    for (final e in root.listSync()) {
-      if (e is Directory) {
-        final f = File('${e.path}/SKILL.md');
-        if (await f.exists()) {
-          final text = await f.readAsString();
-          _skills.add(_parse(e.path.split('/').last, text));
-        }
-      }
-    }
-  }
-
-  Future<void> save(Skill s) async {
-    final dir = await NativeBridge.appDataDir();
-    if (dir.isEmpty) return;
-    final f = File('$dir/skills/${s.name}/SKILL.md');
-    await f.parent.create(recursive: true);
-    final fm = '---\nname: ${s.name}\ndescription: ${s.description}\n---\n\n';
-    await f.writeAsString('$fm${s.body}');
-    await load();
-  }
-
-  Skill _parse(String name, String text) {
-    var desc = '';
-    var body = text;
-    if (text.startsWith('---')) {
-      final end = text.indexOf('\n---', 3);
-      if (end > 0) {
-        final fm = text.substring(3, end);
-        body = text.substring(end + 4).trim();
-        for (final line in const LineSplitter().convert(fm)) {
-          if (line.toLowerCase().startsWith('description:')) {
-            desc = line.substring(12).trim();
-          }
-        }
-      }
-    }
-    return Skill(name, desc, body);
-  }
-
-  String catalog() {
-    if (_skills.isEmpty) return '（暂无技能）';
-    return _skills.map((s) => '- ${s.name}: ${s.description}').join('\n');
-  }
-}
