index 3dcde2a..d5891f5 100644
--- a/lib/agent/quick_store.dart
+++ b/lib/agent/quick_store.dart
@@ -40,19 +40,28 @@ class QuickStore {
     return File('$dir/quick_actions.json');
   }
 
-  static List<QuickAction> defaults() => [
-        QuickAction(label: '终端', icon: 'terminal', type: 'open', arg: 'terminal'),
-        QuickAction(label: '逆向', icon: 'shield', type: 'open', arg: 'reverse'),
-        QuickAction(label: '文件', icon: 'folder', type: 'open', arg: 'files'),
-        QuickAction(label: '悬浮窗', icon: 'layers', type: 'open', arg: 'overlay'),
-      ];
+  /// 不再自带默认快捷：需要的项由用户从抽屉拖进来。
+  static List<QuickAction> defaults() => const [];
+
+  /// 旧版本自带的四项，加载时清掉。
+  static const List<(String, String)> _legacyDefaults = [
+    ('open', 'terminal'),
+    ('open', 'reverse'),
+    ('open', 'files'),
+    ('open', 'overlay'),
+  ];
 
   static Future<List<QuickAction>> load() async {
     try {
       final f = await _file();
       if (f == null || !await f.exists()) return defaults();
       final list = jsonDecode(await f.readAsString()) as List;
-      return list.map((e) => QuickAction.fromJson(Map<String, dynamic>.from(e as Map))).toList();
+      final all = list.map((e) => QuickAction.fromJson(Map<String, dynamic>.from(e as Map))).toList();
+      final kept = all
+          .where((q) => !_legacyDefaults.any((d) => d.$1 == q.type && d.$2 == q.arg))
+          .toList();
+      if (kept.length != all.length) await save(kept);
+      return kept;
     } catch (_) {
       return defaults();
     }
