@@ -265,6 +265,7 @@ class _ChatPageState extends ConsumerState<ChatPage> {
                         viewData: {
                           'lines': List<String>.from(engine.liveLines),
                           'running': true,
+                          'elapsed': engine.liveElapsed,
                         }));
                     WidgetsBinding.instance.addPostFrameCallback((_) {
                       if (_scroll.hasClients && _atBottom) {
diff --git a/lib/widgets/view_cards.dart b/lib/widgets/view_cards.dart
index 450e046..5c0258d 100644
--- a/lib/widgets/view_cards.dart
+++ b/lib/widgets/view_cards.dart
@@ -253,9 +253,13 @@ class _StreamViewCardState extends State<_StreamViewCard> {
   Widget build(BuildContext context) {
     final lines = ((widget.data['lines'] as List?) ?? const []).map((e) => '$e').toList();
     final running = widget.data['running'] == true;
+    final elapsed = (widget.data['elapsed'] as num?)?.toInt() ?? 0;
+    final dur = elapsed >= 60
+        ? '${elapsed ~/ 60}m${(elapsed % 60).toString().padLeft(2, '0')}s'
+        : '${elapsed}s';
     return _shell(
       title: widget.title,
-      subtitle: running ? '运行中' : '已结束',
+      subtitle: running ? '运行中 · $dur' : '完成 · $dur',
       child: Container(
         margin: const EdgeInsets.all(10),
         padding: const EdgeInsets.all(10),
