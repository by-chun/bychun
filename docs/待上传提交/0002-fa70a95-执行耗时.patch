- 执行开始记时间，每秒刷新，卡片标题右侧显示「运行中 · 12s」
- 结束后固定为「完成 · 1m05s」并写入 viewData.elapsed
- 停止/结束时清理定时器
- 版本 6.2.2+622（仅本地提交）
---
 lib/agent/agent_engine.dart | 22 +++++++++++++++++++++-
 lib/pages/chat_page.dart    |  1 +
 lib/widgets/view_cards.dart |  6 +++++-
 pubspec.yaml                |  2 +-
 4 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/lib/agent/agent_engine.dart b/lib/agent/agent_engine.dart
index 9a5cd6c..14ead89 100644
--- a/lib/agent/agent_engine.dart
+++ b/lib/agent/agent_engine.dart
@@ -1,3 +1,4 @@
+import 'dart:async';
 import 'dart:convert';
 import 'dart:io';
 import 'package:flutter/foundation.dart';
@@ -73,6 +74,8 @@ class AgentEngine extends ChangeNotifier {
     streamingText = '';
     liveActive = false;
     liveLines.clear();
+    _liveTicker?.cancel();
+    _liveTicker = null;
     // 立刻掐断正在飞的请求，不用等模型返回
     try {
       _llm?.abort();
@@ -98,11 +101,24 @@ class AgentEngine extends ChangeNotifier {
   bool liveActive = false;
   String liveTitle = '';
   final List<String> liveLines = [];
+  DateTime? liveStartedAt;
+  Timer? _liveTicker;
+
+  /// 已运行秒数（流式卡片展示用）。
+  int get liveElapsed => liveStartedAt == null
+      ? 0
+      : DateTime.now().difference(liveStartedAt!).inSeconds;
 
   void startLive(String title) {
     liveActive = true;
+    liveStartedAt = DateTime.now();
     liveTitle = title.length > 40 ? '${title.substring(0, 40)}…' : title;
     liveLines.clear();
+    _liveTicker?.cancel();
+    // 每秒刷一次，让卡片上的耗时持续跳动
+    _liveTicker = Timer.periodic(const Duration(seconds: 1), (_) {
+      if (liveActive) notifyListeners();
+    });
     notifyListeners();
   }
 
@@ -115,13 +131,17 @@ class AgentEngine extends ChangeNotifier {
 
   void endLive(int code) {
     if (!liveActive) return;
+    final elapsed = liveElapsed;
     liveActive = false;
+    liveStartedAt = null;
+    _liveTicker?.cancel();
+    _liveTicker = null;
     final lines = List<String>.from(liveLines)..add('[exit $code]');
     notifyListeners();
     _add(ChatMsg('view', '',
         view: 'stream',
         viewTitle: '终端 · $liveTitle',
-        viewData: {'lines': lines, 'running': false}));
+        viewData: {'lines': lines, 'running': false, 'elapsed': elapsed}));
   }
 
   void resolvePermission(String choice) {
