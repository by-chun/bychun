+  /// 设置项：先在树里展开子项，点标题才进页面。
+  Widget _settingNode(String key, String title, Widget page) {
+    final k = 'set:$key';
+    final open = _isOpen(k);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        InkWell(
+          onTap: () => _toggle(k),
+          child: Padding(
+            padding: const EdgeInsets.fromLTRB(30, 9, 12, 9),
+            child: Row(children: [
+              Icon(open ? Icons.keyboard_arrow_down_rounded : Icons.keyboard_arrow_right_rounded,
+                  size: 13, color: const Color(0xFFC3CCD8)),
+              const SizedBox(width: 6),
+              Expanded(child: Text(title, style: const TextStyle(fontSize: 12.5, color: Color(0xFF334155)))),
+              const Icon(Icons.chevron_right_rounded, size: 15, color: Color(0xFFCBD5E1)),
+            ]),
+          ),
+        ),
+        AnimatedSize(
+          duration: const Duration(milliseconds: 160),
+          curve: Curves.easeOutCubic,
+          alignment: Alignment.topCenter,
+          child: open
+              ? FutureBuilder<List<String>>(
+                  future: _subItems(key),
+                  builder: (_, snap) {
+                    final items = snap.data ?? const <String>[];
+                    return Padding(
+                      padding: const EdgeInsets.only(left: 48, right: 12, bottom: 4),
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          for (final it in items)
+                            Padding(
+                              padding: const EdgeInsets.symmetric(vertical: 3),
+                              child: Text(it,
+                                  maxLines: 1,
+                                  overflow: TextOverflow.ellipsis,
+                                  style: const TextStyle(
+                                      fontSize: 11, color: Color(0xFF64748B), fontFamily: 'monospace')),
+                            ),
+                          if (items.isEmpty)
+                            const Padding(
+                              padding: EdgeInsets.symmetric(vertical: 3),
+                              child: Text('（空）', style: TextStyle(fontSize: 11, color: Color(0xFFB6C0CD))),
+                            ),
+                          InkWell(
+                            onTap: () => widget.onOpenPage(page),
+                            child: const Padding(
+                              padding: EdgeInsets.only(top: 4, bottom: 2),
+                              child: Text('打开设置页 ›',
+                                  style: TextStyle(fontSize: 11, color: Color(0xFF2563EB))),
+                            ),
+                          ),
+                        ],
+                      ),
+                    );
+                  },
+                )
+              : const SizedBox(width: double.infinity, height: 0),
+        ),
+      ],
     );
   }
 
+  Future<List<String>> _subItems(String key) async {
+    try {
+      switch (key) {
+        case 'provider':
+          final (list, active) = await ProviderStore.loadAllWithActive();
+          return list
+              .map((p) => '${p.name}${p.name == active ? ' · 当前' : ''}  ${p.model}')
+              .toList();
+        case 'subagent':
+          final subs = await ref.read(appDbProvider).allSubAgents();
+          return subs.map((a) => '${a.name} · ${a.modelTier}').toList();
+        case 'container':
+          final envs = await NativeBridge.envList();
+          return envs.map((e) => '${e['name']}${e['ready'] == true ? '' : ' · 未就绪'}').toList();
+        case 'persona':
+          return const [];
+        case 'perm':
+          return const ['常用 / 应用与媒体 / 系统能力', 'AI 工具授权（可左滑删规则）'];
+        case 'compact':
+          return const ['触发阈值 · 保留条数 · 工具轮数上限'];
+        case 'backup':
+          return const ['导出全部配置为 JSON', '从备份恢复'];
+        default:
+          return const [];
+      }
+    } catch (_) {
+      return const [];
+    }
+  }
+
   static String _size(int b) {
     if (b >= 1024 * 1024 * 1024) return '${(b / 1024 / 1024 / 1024).toStringAsFixed(1)}GB';
     if (b >= 1024 * 1024) return '${(b / 1024 / 1024).toStringAsFixed(0)}MB';
