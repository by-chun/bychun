 lib/agent/agent_engine.dart | 53 +++++++++++++++++++++++++++++++++++--
 lib/pages/chat_message.dart |  7 ++++-
 lib/pages/chat_page.dart    |  2 +-
 pubspec.yaml                |  2 +-
 4 files changed, 59 insertions(+), 5 deletions(-)

diff --git a/lib/agent/agent_engine.dart b/lib/agent/agent_engine.dart
index b852026..bdf71f1 100644
--- a/lib/agent/agent_engine.dart
+++ b/lib/agent/agent_engine.dart
@@ -76,6 +76,7 @@ class AgentEngine extends ChangeNotifier {
     _stopRequested = true;
     streaming = false;
     streamingText = '';
+    _stopTyping();
     liveActive = false;
     liveLines.clear();
     _liveTicker?.cancel();
@@ -101,6 +102,53 @@ class AgentEngine extends ChangeNotifier {
   bool streaming = false;
   String streamingText = '';
 
+  // 打字机：网络 chunk 先入队，再按节拍往外吐，避免整块蹦出
+  String _pendingText = '';
+  Timer? _typeTimer;
+  bool _streamClosed = true;
+  Completer<void>? _drained;
+
+  void _beginTyping() {
+    _pendingText = '';
+    _streamClosed = false;
+    _drained = Completer<void>();
+    _typeTimer?.cancel();
+    _typeTimer = Timer.periodic(const Duration(milliseconds: 20), (_) {
+      if (_pendingText.isEmpty) {
+        if (_streamClosed) {
+          _typeTimer?.cancel();
+          _typeTimer = null;
+          final d = _drained;
+          if (d != null && !d.isCompleted) d.complete();
+        }
+        return;
+      }
+      // 队列越长吐得越快，整体控制在 1 秒内排完
+      final n = (_pendingText.length / 20).ceil().clamp(1, 40);
+      final cut = n >= _pendingText.length ? _pendingText.length : n;
+      streamingText += _pendingText.substring(0, cut);
+      _pendingText = _pendingText.substring(cut);
+      notifyListeners();
+    });
+  }
+
+  /// 等待队列吐完（流结束后调用）。
+  Future<void> _finishTyping() async {
+    _streamClosed = true;
+    final d = _drained;
+    if (d != null && !d.isCompleted) await d.future;
+  }
+
+  void _stopTyping() {
+    _typeTimer?.cancel();
+    _typeTimer = null;
+    _pendingText = '';
+    _streamClosed = true;
+    final d = _drained;
+    if (d != null && !d.isCompleted) d.complete();
+    _drained = null;
+  }
+
   /// 正在执行的命令：实时输出渲染成 stream 卡片。
   bool liveActive = false;
   String liveTitle = '';
@@ -496,10 +544,11 @@ class AgentEngine extends ChangeNotifier {
       streamingText = '';
       notifyListeners();
       final t0 = DateTime.now();
+      _beginTyping();
       final resp = await _llm!.chatStream(api, tools, onDelta: (d) {
-        streamingText += d;
-        notifyListeners();
+        _pendingText += d;
       });
+      await _finishTyping();
       final streamed = streamingText;
       final tookMs = DateTime.now().difference(t0).inMilliseconds;
       streaming = false;
diff --git a/lib/pages/chat_message.dart b/lib/pages/chat_message.dart
index f08b9d1..e061dfd 100644
--- a/lib/pages/chat_message.dart
+++ b/lib/pages/chat_message.dart
@@ -293,7 +293,12 @@ class _TypewriterTextState extends State<TypewriterText> {
   @override
   void didUpdateWidget(covariant TypewriterText old) {
     super.didUpdateWidget(old);
-    if (old.text != widget.text) _start();
+    if (old.text == widget.text) return;
+    // 流式追加：文本只是变长时接着往下打，不要重头开始
+    final appended = widget.text.startsWith(old.text) && _n <= old.text.length;
+    if (appended && _t != null && _t!.isActive) return;
+    if (appended && _n >= widget.text.length) return;
+    _start();
   }
 
   @override
