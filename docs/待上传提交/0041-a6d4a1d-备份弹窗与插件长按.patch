+  Future<void> _runFile(String path, String name) async {
+    final ext = name.contains('.') ? name.split('.').last.toLowerCase() : '';
+    final interp = switch (ext) {
+      'sh' || 'bash' => 'sh',
+      'py' => 'python3',
+      'js' => 'node',
+      'lua' => 'lua',
+      _ => null,
+    };
+    if (interp == null) {
+      _toast('这个类型不能直接运行');
+      return;
+    }
+    final r = await NativeBridge.exec("$interp '${path.replaceAll("'", "'\\''")}'", timeout: 60);
+    if (!mounted) return;
+    final out = '${r.stdout}${r.stderr}'.trim();
+    await showDialog<void>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: Colors.white,
+        title: Text('exit ${r.code}', style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w700)),
+        content: SingleChildScrollView(
+          child: Text(out.isEmpty ? '（无输出）' : out,
+              style: const TextStyle(fontSize: 11, fontFamily: 'monospace', height: 1.5)),
+        ),
+        actions: [TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('关闭'))],
+      ),
+    );
+  }
+
+  Future<void> _markXposed(String path, String name) async {
+    final t = TextEditingController();
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: Colors.white,
+        title: const Text('作为 Xposed 模块运行', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+        content: Column(mainAxisSize: MainAxisSize.min, crossAxisAlignment: CrossAxisAlignment.start, children: [
+          const Text('目标包名，多个用逗号分隔', style: TextStyle(fontSize: 11, color: Color(0xFF94A3B8))),
+          const SizedBox(height: 6),
+          TextField(controller: t, decoration: const InputDecoration(hintText: 'com.example.app')),
+        ]),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+          FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('保存')),
+        ],
+      ),
+    );
+    if (ok != true) return;
+    final targets = t.text.split(',').map((e) => e.trim()).where((e) => e.isNotEmpty).toList();
+    if (targets.isEmpty) return;
+    final r = await NativeBridge.exec("cat '${path.replaceAll("'", "'\\''")}'");
+    final list = await XposedStore.load();
+    final item = XposedScript(name: name, targets: targets, code: r.ok ? r.stdout : '');
+    final i = list.indexWhere((s) => s.name == name);
+    if (i >= 0) {
+      list[i] = item;
+    } else {
+      list.add(item);
+    }
+    await XposedStore.save(list);
+    if (!mounted) return;
+    _toast('已登记为 Xposed 模块，重启目标应用生效');
+  }
+
