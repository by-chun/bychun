+  // ---------------- 会话 ----------------
+  Widget _sessionChildren() {
+    final db = ref.read(appDbProvider);
+    final active = ref.watch(activeSessionProvider);
+    return StreamBuilder<List<Session>>(
+      stream: db.watchSessions(),
+      builder: (context, snap) {
+        final list = snap.data ?? const <Session>[];
+        if (list.isEmpty) {
+          return const Padding(
+            padding: EdgeInsets.fromLTRB(34, 4, 10, 10),
+            child: Text('（还没有会话）', style: TextStyle(fontSize: 10.5, color: Color(0xFF94A3B8))),
+          );
+        }
+        return Column(children: [
+          for (final s in list.take(30))
+            InkWell(
+              onTap: () {
+                ref.read(activeSessionProvider.notifier).open(s.id);
+                widget.onClose?.call();
+              },
+              child: Padding(
+                padding: const EdgeInsets.fromLTRB(34, 8, 10, 8),
+                child: Row(children: [
+                  Icon(
+                    s.id == active ? Icons.chat_bubble_rounded : Icons.chat_bubble_outline_rounded,
+                    size: 13,
+                    color: s.id == active ? const Color(0xFF2563EB) : const Color(0xFFC3CCD8),
+                  ),
+                  const SizedBox(width: 7),
+                  Expanded(
+                    child: Text(
+                      s.title.isEmpty ? '新对话' : s.title,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyle(
+                          fontSize: 12,
+                          color: s.id == active ? const Color(0xFF2563EB) : const Color(0xFF334155)),
+                    ),
+                  ),
+                ]),
+              ),
+            ),
+          Padding(
+            padding: const EdgeInsets.only(left: 34, top: 2, bottom: 8),
+            child: InkWell(
+              onTap: () {
+                ref.read(activeSessionProvider.notifier).reset();
+                widget.onClose?.call();
+              },
+              child: const Text('＋ 新对话', style: TextStyle(fontSize: 11, color: Color(0xFF2563EB))),
+            ),
+          ),
+        ]);
+      },
+    );
+  }
