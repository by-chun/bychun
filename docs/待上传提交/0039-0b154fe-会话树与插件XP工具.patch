+class ShizukuExecTool extends AgentTool {
+  @override
+  String get name => 'shizukuExec';
+  @override
+  String get description => '通过 Shizuku 以 shell 权限执行命令（免 root）。需已装 Shizuku 并授权。';
+  @override
+  Map<String, String> get parameters => {'cmd': '要执行的命令'};
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final cmd = args['cmd'] ?? '';
+    if (cmd.isEmpty) return const ToolResult(false, 'cmd 为空');
+    if (!await NativeBridge.shizukuAvailable()) {
+      return const ToolResult(false, 'Shizuku 未就绪：先安装并启动 Shizuku');
     }
+    if (!await NativeBridge.shizukuPermission()) await NativeBridge.shizukuRequest();
+    final r = await NativeBridge.shizukuExec(cmd);
+    final out = '${r.stdout}${r.stderr}'.trim();
+    return ToolResult(r.ok, out.isEmpty ? '（无输出，exit ${r.code}）' : out);
+  }
+}
+
+class FridaStartTool extends AgentTool {
+  @override
+  String get name => 'fridaStart';
+  @override
+  String get description => '启动 frida-server（需设备上已有二进制，不内置）。';
+  @override
+  Map<String, String> get parameters => {'path': '可选：frida-server 路径，默认 /data/local/tmp/frida-server'};
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final path = (args['path'] ?? '').trim();
+    final ok = path.isEmpty ? await NativeBridge.fridaStart() : await NativeBridge.fridaStart(path);
+    return ToolResult(ok, ok ? 'frida-server 已启动' : '启动失败：文件不存在或无权限');
+  }
+}
+
+class FridaStopTool extends AgentTool {
+  @override
+  String get name => 'fridaStop';
+  @override
+  String get description => '停止 frida-server。';
+  @override
+  Map<String, String> get parameters => {};
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final ok = await NativeBridge.fridaStop();
+    return ToolResult(ok, ok ? 'frida-server 已停止' : '没有可停止的 frida-server');
   }
 }
