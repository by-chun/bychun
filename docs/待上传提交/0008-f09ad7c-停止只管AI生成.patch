Date: Wed, 25 Nov 2026 15:11:24 +0800
Subject: [PATCH] =?UTF-8?q?fix(chat):=20=E5=81=9C=E6=AD=A2=E5=8F=AA?=
 =?UTF-8?q?=E7=AE=A1=20AI=20=E7=94=9F=E6=88=90=EF=BC=8C=E5=90=8E=E5=8F=B0?=
 =?UTF-8?q?=E4=BB=BB=E5=8A=A1=E4=BA=A4=E7=BB=99=20AI=20=E5=85=B3?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- stop() 不再 killAllProcs / killStream，只中止模型请求、解除授权等待、清流式状态
- 后台命令继续跑（服务、下载），用户可以让 AI 调 stop_tasks 统一关掉
- 新增 stop_tasks 工具（高危，每次确认）
- 版本 6.2.8+628（仅本地提交）
---
 lib/agent/agent_engine.dart  | 10 ++--------
 lib/agent/permission.dart    |  1 +
 lib/agent/tools_capture.dart | 15 +++++++++++++++
 pubspec.yaml                 |  2 +-
 4 files changed, 19 insertions(+), 9 deletions(-)

diff --git a/lib/agent/agent_engine.dart b/lib/agent/agent_engine.dart
index fffcb87..f848dc3 100644
--- a/lib/agent/agent_engine.dart
+++ b/lib/agent/agent_engine.dart
@@ -107,17 +107,10 @@ class AgentEngine extends ChangeNotifier {
     liveLines.clear();
     _liveTicker?.cancel();
     _liveTicker = null;
-    // 立刻掐断正在飞的请求，不用等模型返回
+    // 只中止 AI 生成侧的请求；后台任务（服务、下载）不动
     try {
       _llm?.abort();
     } catch (_) {}
-    // 杀掉正在跑的容器命令
-    final tag = RunStreamTool.currentTag;
-    if (tag != null) {
-      NativeBridge.killStream(tag);
-    }
-    // 急停：把还在跑的容器命令全部杀掉，不用等它自己结束
-    NativeBridge.killAllProcs();
     notifyListeners();
     // 兜底：3 秒还没退出就强制解锁 UI，并让后台流程立刻作废
     Future.delayed(const Duration(seconds: 3), () {
@@ -286,6 +279,7 @@ class AgentEngine extends ChangeNotifier {
     registry.register(CaptureStopTool());
     registry.register(CaptureRecordClearTool());
     registry.register(CaptureListTool());
+    registry.register(StopTasksTool());
     registry.register(SetGitCredentialTool());
     registry.register(SetWorkspaceTool());
     registry.register(InstallApkTool());
diff --git a/lib/agent/permission.dart b/lib/agent/permission.dart
index 801e322..05adcaa 100644
--- a/lib/agent/permission.dart
+++ b/lib/agent/permission.dart
@@ -34,6 +34,7 @@ class PermissionPolicy {
     'installApk',
     'install_container',
     'runPlugin',
+    'stop_tasks',
   };
 
   static bool isHighRisk(String tool) => highRisk.contains(tool) || tool.startsWith('root');
diff --git a/lib/agent/tools_capture.dart b/lib/agent/tools_capture.dart
index 7512132..1e0415a 100644
--- a/lib/agent/tools_capture.dart
+++ b/lib/agent/tools_capture.dart
@@ -104,3 +104,18 @@ class CaptureListTool extends AgentTool {
     return '${two(d.hour)}:${two(d.minute)}:${two(d.second)}';
   }
 }
+
+/// 停止容器里所有后台命令（对话里的停止只管 AI 生成，后台任务要靠这个关）。
+class StopTasksTool extends AgentTool {
+  @override
+  String get name => 'stop_tasks';
+  @override
+  String get description => '停止容器里所有正在后台运行的命令与进程（不影响当前对话）。';
+  @override
+  Map<String, String> get parameters => const {};
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    await NativeBridge.killAllProcs();
+    return const ToolResult(true, '已停止所有后台命令');
+  }
+}
diff --git a/pubspec.yaml b/pubspec.yaml
index 93d0eed..310c43a 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: 'none' # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
 # In Windows, build-name is used as the major, minor, and patch parts
 # of the product and file versions while build-number is used as the build suffix.
-version: 6.2.7+627
+version: 6.2.8+628
 
 environment:
   sdk: ^3.9.2
