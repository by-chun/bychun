Subject: [PATCH] =?UTF-8?q?feat(provider):=20=E4=BE=9B=E5=BA=94=E5=95=86?=
 =?UTF-8?q?=E9=A1=B5=E6=94=B9=E7=89=88?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- 两个按钮合并为「测试并拉取模型」（原来测试/拉取调的是同一个函数）
- API Key 去掉 obscureText，不再弹系统安全键盘
- 去掉所有输入框的占位示例（DeepSeek / 粘贴 Key / https://…）
- 模型改多选：已选 chips（点选设默认、× 移除）+「添加」弹窗复选（支持全选）
- 版本 6.4.1+641（仅本地提交）
---
 lib/pages/settings_page.dart | 132 ++++++++++++++++++++++++++---------
 pubspec.yaml                 |   2 +-
 2 files changed, 101 insertions(+), 33 deletions(-)

diff --git a/lib/pages/settings_page.dart b/lib/pages/settings_page.dart
index 0542b0e..2dbb995 100644
--- a/lib/pages/settings_page.dart
+++ b/lib/pages/settings_page.dart
@@ -458,7 +458,8 @@ class _ProviderEditPageState extends State<ProviderEditPage> {
   final _url = TextEditingController();
   String _protocol = 'OpenAI 兼容';
   String _testMsg = '';
-  List<String> _models = [];
+  List<String> _available = [];
+  final Set<String> _picked = {};
   String _model = '';
 
   @override
@@ -470,9 +471,10 @@ class _ProviderEditPageState extends State<ProviderEditPage> {
       _key.text = c.apiKey;
       _url.text = c.baseUrl;
       _protocol = c.protocol;
-      _models = List.of(c.models);
+      _available = List.of(c.models);
+      _picked.addAll(c.models);
       _model = c.model;
-      if (!_models.contains(_model) && _model.isNotEmpty) _models.insert(0, _model);
+      if (_model.isNotEmpty) _picked.add(_model);
     }
   }
 
@@ -492,8 +494,8 @@ class _ProviderEditPageState extends State<ProviderEditPage> {
       baseUrl: _url.text.trim(),
       apiKey: _key.text.trim(),
       protocol: _protocol,
-      models: _models,
-      model: _model,
+      models: _picked.toList(),
+      model: _model.isEmpty && _picked.isNotEmpty ? _picked.first : _model,
     );
     final oldName = widget.initial?.name;
     final idx = oldName == null ? -1 : list.indexWhere((e) => e.name == oldName);
@@ -528,15 +530,74 @@ class _ProviderEditPageState extends State<ProviderEditPage> {
         if (!id.contains('embedding')) ids.add(id);
       }
       setState(() {
-        _models = ids;
-        _model = ids.isEmpty ? '' : ids.first;
-        _testMsg = ids.isEmpty ? '✓ 连接正常（未解析到模型列表）' : '✓ 连接正常 · ${ids.length} 个模型';
+        _available = ids;
+        if (_picked.isEmpty && ids.isNotEmpty) {
+          _picked.add(ids.first);
+          _model = ids.first;
+        }
+        _testMsg = ids.isEmpty ? '✓ 连接正常（未解析到模型列表）' : '✓ 连接正常 · ${ids.length} 个模型，点「添加」选';
       });
     } catch (e) {
       setState(() => _testMsg = '✗ ${e.toString().split('\n').first}');
     }
   }
 
+  Future<void> _pickModels() async {
+    final all = <String>{..._available, ..._picked}.toList()..sort();
+    if (all.isEmpty) {
+      setState(() => _testMsg = '先点「测试并拉取模型」');
+      return;
+    }
+    final picked = Set<String>.from(_picked);
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => StatefulBuilder(
+        builder: (ctx, setD) => AlertDialog(
+          backgroundColor: Colors.white,
+          title: Row(children: [
+            const Text('选择模型', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+            const Spacer(),
+            TextButton(onPressed: () => setD(() => picked.addAll(all)), child: const Text('全选')),
+          ]),
+          content: SizedBox(
+            width: double.maxFinite,
+            child: ListView(
+              shrinkWrap: true,
+              children: [
+                for (final m in all)
+                  CheckboxListTile(
+                    dense: true,
+                    contentPadding: EdgeInsets.zero,
+                    value: picked.contains(m),
+                    title: Text(m, style: const TextStyle(fontSize: 12, fontFamily: 'monospace')),
+                    onChanged: (v) => setD(() {
+                      if (v == true) {
+                        picked.add(m);
+                      } else {
+                        picked.remove(m);
+                      }
+                    }),
+                  ),
+              ],
+            ),
+          ),
+          actions: [
+            TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+            FilledButton(onPressed: () => Navigator.pop(ctx, true), child: Text('确定（${picked.length}）')),
+          ],
+        ),
+      ),
+    );
+    if (ok == true) {
+      setState(() {
+        _picked
+          ..clear()
+          ..addAll(picked);
+        if (!_picked.contains(_model) && _picked.isNotEmpty) _model = _picked.first;
+      });
+    }
+  }
+
   @override
   Widget build(BuildContext context) {
     return Scaffold(
@@ -555,40 +616,47 @@ class _ProviderEditPageState extends State<ProviderEditPage> {
         padding: const EdgeInsets.all(16),
         children: [
           const Text('名称', style: TextStyle(fontSize: 11, color: AppColors.muted)),
-          TextField(controller: _name, decoration: const InputDecoration(hintText: '例如 DeepSeek、本地 Ollama')),
+          TextField(controller: _name),
           const SizedBox(height: 10),
           const Text('API Key', style: TextStyle(fontSize: 11, color: AppColors.muted)),
-          TextField(controller: _key, obscureText: true, decoration: const InputDecoration(hintText: '粘贴 Key')),
+          TextField(controller: _key),
           const SizedBox(height: 10),
           const Text('Base URL', style: TextStyle(fontSize: 11, color: AppColors.muted)),
-          TextField(controller: _url, decoration: const InputDecoration(hintText: 'https://…')),
+          TextField(controller: _url),
           const SizedBox(height: 10),
           Row(children: [
-            GlassButton(label: '测试连接', icon: Icons.wifi_tethering_rounded, onTap: _fetch),
-            const SizedBox(width: 10),
-            GlassButton(label: '拉取模型', icon: Icons.refresh_rounded, onTap: _fetch),
+            GlassButton(label: '测试并拉取模型', icon: Icons.wifi_tethering_rounded, onTap: _fetch),
           ]),
           if (_testMsg.isNotEmpty)
             Padding(padding: const EdgeInsets.only(top: 8), child: Text(_testMsg, style: const TextStyle(fontSize: 12, color: AppColors.muted))),
-          if (_models.isNotEmpty) ...[
-            const Padding(padding: EdgeInsets.only(top: 12), child: Text('当前模型（点选）', style: TextStyle(fontSize: 11, color: AppColors.muted))),
-            Wrap(
-              spacing: 6,
-              runSpacing: 6,
-              children: [
-                for (final m in _models)
-                  ChoiceChip(
-                    label: Text(m, style: const TextStyle(fontSize: 11, fontFamily: 'monospace')),
-                    selected: _model == m,
-                    onSelected: (_) => setState(() => _model = m),
-                  ),
-              ],
+          const Padding(padding: EdgeInsets.only(top: 14, bottom: 6), child: Text('已选模型（可多选，点选设为默认）', style: TextStyle(fontSize: 11, color: AppColors.muted))),
+          Wrap(
+            spacing: 6,
+            runSpacing: 6,
+            children: [
+              for (final m in _picked)
+                InputChip(
+                  label: Text(m, style: const TextStyle(fontSize: 11, fontFamily: 'monospace')),
+                  selected: _model == m,
+                  onSelected: (_) => setState(() => _model = m),
+                  onDeleted: () => setState(() {
+                    _picked.remove(m);
+                    if (_model == m) _model = _picked.isEmpty ? '' : _picked.first;
+                  }),
+                ),
+              ActionChip(
+                avatar: const Icon(Icons.add_rounded, size: 14, color: AppColors.brand),
+                label: const Text('添加', style: TextStyle(fontSize: 11, color: AppColors.brand)),
+                onPressed: _pickModels,
+              ),
+            ],
+          ),
+          if (_picked.isEmpty)
+            const Padding(
+              padding: EdgeInsets.only(top: 6),
+              child: Text('先点「测试并拉取模型」，再点「添加」选模型',
+                  style: TextStyle(fontSize: 10.5, color: AppColors.muted)),
             ),
-          ] else ...[
-            const SizedBox(height: 10),
-            const Text('模型列表为空：先点「拉取模型」，再检查 Key / Base URL',
-                style: TextStyle(fontSize: 10.5, color: AppColors.muted)),
-          ],
         ],
       ),
     );
