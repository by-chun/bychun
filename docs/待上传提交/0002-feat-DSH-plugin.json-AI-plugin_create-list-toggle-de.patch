diff --git a/lib/agent/plugins_store.dart b/lib/agent/plugins_store.dart
new file mode 100644
index 0000000..209591b
--- /dev/null
+++ b/lib/agent/plugins_store.dart
@@ -0,0 +1,188 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../native/native_bridge.dart';
+
+/// Rowan 插件清单（`plugin.json`），仿 dsh-go 的声明式设计：
+/// 一个目录 = 一个插件；清单声明它在 App 里出现什么；按钮点按可以带静态效果。
+///
+/// 目录结构：
+///   /storage/emulated/0/Rowan/plugins/<id>/plugin.json
+///
+/// 清单字段：
+/// {
+///   "v": 1,
+///   "id": "local-quote",
+///   "title": "引用",
+///   "icon": "quote",                       // 可选
+///   "enabled": true,                        // 可选，开关
+///   "composer.actions": [ {id,label,icon?,effect?} ],   // 输入框上方胶囊（≤2）
+///   "message.actions":  [ {id,label,icon?,effect?} ],   // 长按回复菜单（≤2）
+///   "panels": [ {id,title,icon?,view?} ]               // 面板（≤4），view 是 JSON 视图树
+/// }
+///
+/// effect（静态效果，App 直接执行，不跑代码）：
+///   { "insert": "文字" }   放进输入框，不自动发送
+///   { "send": "文字" }     直接作为消息发送给 AI
+///   { "toast": "提示" }
+///   { "open": "panel:<id>" }
+class RowanPlugin {
+  final String id;
+  final String dir;
+  final Map<String, dynamic> manifest;
+  final bool enabled;
+
+  const RowanPlugin({required this.id, required this.dir, required this.manifest, required this.enabled});
+
+  String get title => (manifest['title'] is Map)
+      ? ((manifest['title']['zh'] ?? manifest['title']['en'] ?? id).toString())
+      : (manifest['title'] ?? id).toString();
+
+  String get icon => (manifest['icon'] ?? 'plugin').toString();
+
+  /// 输入框上方胶囊（最多 2 个）。
+  List<Map<String, dynamic>> get composerActions =>
+      _listOf(manifest['composer.actions'], 2);
+
+  /// 长按回复菜单项（最多 2 个）。
+  List<Map<String, dynamic>> get messageActions =>
+      _listOf(manifest['message.actions'], 2);
+
+  /// 面板（最多 4 个）。
+  List<Map<String, dynamic>> get panels => _listOf(manifest['panels'], 4);
+
+  static List<Map<String, dynamic>> _listOf(dynamic v, int max) {
+    if (v is! List) return const [];
+    return v.whereType<Map>().take(max).map((e) => Map<String, dynamic>.from(e)).toList();
+  }
+}
+
+class PluginsNotifier extends Notifier<List<RowanPlugin>> {
+  @override
+  List<RowanPlugin> build() {
+    _load();
+    return const [];
+  }
+
+  static String get rootDir => '/storage/emulated/0/Rowan/plugins';
+
+  Future<void> _load() async {
+    state = await loadAll();
+  }
+
+  Future<void> refresh() async => _load();
+
+  /// 扫描插件目录，读取每个 plugin.json。
+  static Future<List<RowanPlugin>> loadAll() async {
+    final root = Directory(rootDir);
+    if (!await root.exists()) return const [];
+    final out = <RowanPlugin>[];
+    await for (final e in root.list()) {
+      if (e is! Directory) continue;
+      final f = File('${e.path}/plugin.json');
+      if (!await f.exists()) continue;
+      try {
+        final m = jsonDecode(await f.readAsString());
+        if (m is Map) {
+          out.add(RowanPlugin(
+            id: (m['id'] ?? e.path.split('/').last).toString(),
+            dir: e.path,
+            manifest: Map<String, dynamic>.from(m),
+            enabled: m['enabled'] != false,
+          ));
+        }
+      } catch (_) {}
+    }
+    return out;
+  }
+
+  /// 创建（或覆盖）一个插件：写目录 + plugin.json。
+  static Future<RowanPlugin> create({
+    required String id,
+    required Map<String, dynamic> manifest,
+  }) async {
+    final safe = RegExp(r'^[A-Za-z0-9][A-Za-z0-9._-]*$').hasMatch(id) ? id : 'plugin-${DateTime.now().millisecondsSinceEpoch}';
+    final dir = Directory('$rootDir/$safe');
+    await dir.create(recursive: true);
+    final m = {...manifest, 'id': safe, 'v': manifest['v'] ?? 1};
+    await File('${dir.path}/plugin.json').writeAsString(const JsonEncoder.withIndent('  ').convert(m));
+    return RowanPlugin(id: safe, dir: dir.path, manifest: m, enabled: m['enabled'] != false);
+  }
+
+  /// 开关插件（改 plugin.json 的 enabled）。
+  static Future<void> setEnabled(String dir, bool enabled) async {
+    final f = File('$dir/plugin.json');
+    if (!await f.exists()) return;
+    final m = jsonDecode(await f.readAsString());
+    if (m is! Map) return;
+    m['enabled'] = enabled;
+    await f.writeAsString(const JsonEncoder.withIndent('  ').convert(m));
+  }
+
+  /// 删除插件目录。
+  static Future<void> delete(String dir) async {
+    try {
+      await Directory(dir).delete(recursive: true);
+    } catch (_) {}
+  }
+}
+
+final pluginsProvider = NotifierProvider<PluginsNotifier, List<RowanPlugin>>(PluginsNotifier.new);
+
+/// 汇总所有启用插件的胶囊按钮（App 全局上限 8 个）。
+List<(RowanPlugin, Map<String, dynamic>)> allComposerActions(List<RowanPlugin> list) {
+  final out = <(RowanPlugin, Map<String, dynamic>)>[];
+  for (final p in list) {
+    if (!p.enabled) continue;
+    for (final a in p.composerActions) {
+      out.add((p, a));
+      if (out.length >= 8) return out;
+    }
+  }
+  return out;
+}
+
+/// 汇总所有启用插件的菜单项。
+List<(RowanPlugin, Map<String, dynamic>)> allMessageActions(List<RowanPlugin> list) {
+  final out = <(RowanPlugin, Map<String, dynamic>)>[];
+  for (final p in list) {
+    if (!p.enabled) continue;
+    for (final a in p.messageActions) {
+      out.add((p, a));
+    }
+  }
+  return out;
+}
+
+/// 执行一个静态效果。
+/// 返回 (type, text)：type = insert / send / toast / open。
+(String, String) applyEffect(Map<String, dynamic> effect) {
+  if (effect['insert'] != null) return ('insert', effect['insert'].toString());
+  if (effect['send'] != null) return ('send', effect['send'].toString());
+  if (effect['open'] != null) return ('open', effect['open'].toString());
+  if (effect['toast'] != null) return ('toast', effect['toast'].toString());
+  return ('toast', '这个按钮没有配置效果');
+}
+
+/// 预置：确保插件目录存在，并放入一个示例插件（首次）。
+Future<void> ensurePluginsSeeded() async {
+  try {
+    final root = Directory(PluginsNotifier.rootDir);
+    await root.create(recursive: true);
+    final example = File('${root.path}/local-hello/plugin.json');
+    if (await example.exists()) return;
+    await PluginsNotifier.create(
+      id: 'local-hello',
+      manifest: {
+        'title': '示例',
+        'icon': 'sparkle',
+        'composer.actions': [
+          {'id': 'summarize', 'label': '总结', 'icon': 'summary', 'effect': {'send': '总结上面的对话，列三条要点。'}},
+          {'id': 'hello', 'label': '打招呼', 'icon': 'chat', 'effect': {'insert': '你好，'}},
+        ],
+      },
+    );
+  } catch (_) {}
+}
diff --git a/lib/agent/tools_rowan_plugin.dart b/lib/agent/tools_rowan_plugin.dart
new file mode 100644
index 0000000..0e02256
--- /dev/null
+++ b/lib/agent/tools_rowan_plugin.dart
@@ -0,0 +1,148 @@
+import 'dart:convert';
+
+import 'tool.dart';
+import 'tool_registry.dart';
+import 'plugins_store.dart';
+
+/// AI 自己创建插件：给一个 JSON 清单就能装上，装完即生效（不用重启）。
+class PluginCreateTool extends AgentTool {
+  @override
+  String get name => 'plugin_create';
+
+  @override
+  String get description =>
+      '创建一个 Rowan 插件（声明式 JSON 清单，装完即生效，不用重启）。'
+      '参数 id（小写字母数字-，如 local-quote）和 manifest（JSON 字符串）。'
+      'manifest 字段：title（标题）、icon（可选：bolt star sparkle heart flag bookmark pin bell clock note document folder search code terminal globe chart lightbulb book puzzle robot chat mail translate image camera mic link summary wrench bug info warning check done settings send copy quote share edit add delete refresh plugin bot agent skill model tool workflow goal plan command time today schedule user group phone cloud server power theme palette）'
+      '、"composer.actions"（输入框上方胶囊，≤2，每个 {id,label≤10字,icon?,effect?}）、'
+      '"message.actions"（长按回复菜单，≤2，{id,label≤12字,icon?,effect?}）、'
+      '"panels"（面板，≤4，{id,title≤16字,icon?,view?}，view 是 JSON 视图树：stack/row/text/metric/list/keyValue/table/actions/progress/callout）。'
+      'effect 是点按后的静态效果，只能写一个：{"insert":"文字"}放进输入框不发、{"send":"文字"}直接发给 AI、{"toast":"提示"}、{"open":"panel:<面板id>"}。'
+      '同一插件内所有 id 不能重复。不要在清单里放密钥。';
+
+  @override
+  Map<String, String> get parameters => {
+        'id': '插件 id：小写字母、数字、- . _，字母数字开头，≤40 字',
+        'manifest': 'JSON 清单字符串，见说明',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final id = (args['id'] ?? '').trim();
+    final raw = (args['manifest'] ?? '').trim();
+    if (id.isEmpty) return const ToolResult(false, 'id 不能为空');
+    if (!RegExp(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$').hasMatch(id)) {
+      return const ToolResult(false, 'id 只能是小写字母、数字、- . _，且字母数字开头');
+    }
+    dynamic m;
+    try {
+      m = jsonDecode(raw);
+    } catch (e) {
+      return ToolResult(false, 'manifest 不是合法 JSON：$e');
+    }
+    if (m is! Map) return const ToolResult(false, 'manifest 必须是 JSON 对象');
+    // 校验：id 不重复、数量上限
+    final ids = <String>{};
+    for (final slot in ['composer.actions', 'message.actions', 'panels']) {
+      final v = m[slot];
+      if (v is! List) continue;
+      for (final e in v) {
+        if (e is! Map) continue;
+        final eid = (e['id'] ?? '').toString();
+        if (eid.isEmpty) return const ToolResult(false, '$slot 里有条目缺 id');
+        if (!ids.add(eid)) return ToolResult(false, 'id 重复：$eid（整个插件内不能重复）');
+      }
+    }
+    try {
+      final p = await PluginsNotifier.create(id: id, manifest: Map<String, dynamic>.from(m));
+      return ToolResult(true, '已创建插件「${p.title}」（${p.dir}）。'
+          '胶囊在输入框上方、菜单项在长按回复的菜单里，已即时生效。'
+          '要改就再调一次 plugin_create 覆盖；要关掉用 plugin_toggle。');
+    } catch (e) {
+      return ToolResult(false, '创建失败：$e');
+    }
+  }
+}
+
+/// 列出已装插件。
+class PluginListTool extends AgentTool {
+  @override
+  String get name => 'plugin_list';
+
+  @override
+  String get description => '列出 /sdcard/Rowan/plugins 下已安装的 Rowan 插件及其开关状态、贡献的按钮/菜单/面板。';
+
+  @override
+  Map<String, String> get parameters => {};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final list = await PluginsNotifier.loadAll();
+    if (list.isEmpty) return const ToolResult(true, '还没有插件。用 plugin_create 创建一个。');
+    final buf = StringBuffer();
+    for (final p in list) {
+      buf.writeln('${p.enabled ? '✓' : '✗'} ${p.id}（${p.title}）${p.dir}');
+      for (final a in p.composerActions) buf.writeln('   胶囊: ${a['id']} · ${a['label']}');
+      for (final a in p.messageActions) buf.writeln('   菜单: ${a['id']} · ${a['label']}');
+      for (final a in p.panels) buf.writeln('   面板: ${a['id']} · ${a['title']}');
+    }
+    return ToolResult(true, buf.toString().trimRight());
+  }
+}
+
+/// 开关插件。
+class PluginToggleTool extends AgentTool {
+  @override
+  String get name => 'plugin_toggle';
+
+  @override
+  String get description => '打开或关闭一个 Rowan 插件（改 plugin.json 的 enabled，即时生效）。';
+
+  @override
+  Map<String, String> get parameters => {
+        'id': '插件 id（或目录名）',
+        'enabled': 'true 打开 / false 关闭',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final id = (args['id'] ?? '').trim();
+    final en = (args['enabled'] ?? 'true').trim().toLowerCase() == 'true';
+    if (id.isEmpty) return const ToolResult(false, 'id 不能为空');
+    final list = await PluginsNotifier.loadAll();
+    final p = list.where((e) => e.id == id || e.dir.endsWith('/$id')).toList();
+    if (p.isEmpty) return ToolResult(false, '没找到插件 $id');
+    await PluginsNotifier.setEnabled(p.first.dir, en);
+    return ToolResult(true, '已${en ? '打开' : '关闭'}插件「${p.first.title}」');
+  }
+}
+
+/// 删除插件。
+class PluginDeleteTool extends AgentTool {
+  @override
+  String get name => 'plugin_delete';
+
+  @override
+  String get description => '删除一个 Rowan 插件（整个目录）。高危，建议先确认。';
+
+  @override
+  Map<String, String> get parameters => {'id': '插件 id（或目录名）'};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final id = (args['id'] ?? '').trim();
+    if (id.isEmpty) return const ToolResult(false, 'id 不能为空');
+    final list = await PluginsNotifier.loadAll();
+    final p = list.where((e) => e.id == id || e.dir.endsWith('/$id')).toList();
+    if (p.isEmpty) return ToolResult(false, '没找到插件 $id');
+    await PluginsNotifier.delete(p.first.dir);
+    return ToolResult(true, '已删除插件 $id');
+  }
+}
+
+void registerRowanPluginTools(ToolRegistry reg) {
+  reg.register(PluginCreateTool());
+  reg.register(PluginListTool());
+  reg.register(PluginToggleTool());
+  reg.register(PluginDeleteTool());
+}
diff --git a/lib/pages/chat_message.dart b/lib/pages/chat_message.dart
index 2e9b370..8ccb3c4 100644
--- a/lib/pages/chat_message.dart
+++ b/lib/pages/chat_message.dart
@@ -434,7 +434,116 @@ class _ToolGroupTileState extends State<ToolGroupTile> {
         children: [for (var k = 0; k < widget.tools.length; k++) _rowCard(k)],
       ),
     );
-  }}
+  }
+
+  /// 第 k 条若是「调用」，第 k+1 条就是它的「结果」（工具调用与结果交替）。
+  static ChatMsg? _resultOf(int k) {
+    final t = widget.tools[k];
+    if (!t.text.startsWith('调用 ')) return null;
+    if (k + 1 < widget.tools.length) return widget.tools[k + 1];
+    return null;
+  }
+
+
+  /// 一行工具调用卡：图标 + 工具名 + 命令 + 耗时 + 行数 + 展开箭头。
+  Widget _rowCard(int k) {
+    final t = widget.tools[k];
+    // 「调用 xxx」行才是一张卡；「结果」行合并进上一张卡
+    if (!t.text.startsWith('调用 ')) return const SizedBox.shrink();
+    final result = _resultOf(k);
+    final lines = _linesOf(result);
+    final elapsed = result?.elapsedMs;
+    final ok = result?.ok ?? true;
+    final open = _expanded.contains(k);
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 4),
+      child: Container(
+        decoration: BoxDecoration(
+          gradient: LinearGradient(
+            begin: Alignment.topLeft,
+            end: Alignment.bottomRight,
+            colors: [Colors.white.withValues(alpha: 0.14), Colors.white.withValues(alpha: 0.06)],
+          ),
+          borderRadius: BorderRadius.circular(11),
+          border: Border.all(color: AppColors.border),
+        ),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            InkWell(
+              onTap: lines.isEmpty ? null : () => setState(() {
+                    if (open) {
+                      _expanded.remove(k);
+                    } else {
+                      _expanded.add(k);
+                    }
+                  }),
+              borderRadius: BorderRadius.circular(11),
+              child: Padding(
+                padding: const EdgeInsets.fromLTRB(9, 8, 9, 8),
+                child: Row(children: [
+                  Icon(ok ? Icons.check_circle_rounded : Icons.cancel_rounded,
+                      size: 12, color: ok ? const Color(0xFF10B981) : AppColors.red),
+                  const SizedBox(width: 6),
+                  Text(t.toolName ?? 'tool',
+                      style: const TextStyle(fontSize: 10.5, fontWeight: FontWeight.w700, color: AppColors.text)),
+                  const SizedBox(width: 8),
+                  Expanded(
+                    child: Text(_cmdOf(t),
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: const TextStyle(fontSize: 10, color: AppColors.muted, fontFamily: 'monospace')),
+                  ),
+                  // 耗时（毫秒）
+                  if (elapsed != null)
+                    Text(
+                      elapsed >= 1000
+                          ? '${(elapsed / 1000).toStringAsFixed(1)}s'
+                          : '${elapsed}ms',
+                      style: TextStyle(
+                          fontSize: 9.5,
+                          fontFamily: 'monospace',
+                          color: elapsed >= 10000 ? AppColors.orange : AppColors.muted),
+                    ),
+                  if (lines.isNotEmpty) ...[
+                    const SizedBox(width: 6),
+                    Text('${lines.length} 行',
+                        style: const TextStyle(fontSize: 9, color: AppColors.muted, fontFamily: 'monospace')),
+                    const SizedBox(width: 4),
+                    AnimatedRotation(
+                      turns: open ? 0.5 : 0,
+                      duration: const Duration(milliseconds: 180),
+                      child: const Icon(Icons.expand_more_rounded, size: 13, color: AppColors.muted),
+                    ),
+                  ],
+                ]),
+              ),
+            ),
+            if (lines.isNotEmpty)
+              AnimatedSize(
+                duration: const Duration(milliseconds: 180),
+                curve: Curves.easeOutCubic,
+                alignment: Alignment.topCenter,
+                child: open
+                    ? Container(
+                        width: double.infinity,
+                        margin: const EdgeInsets.fromLTRB(8, 0, 8, 8),
+                        padding: const EdgeInsets.all(8),
+                        decoration: BoxDecoration(
+                          color: Colors.black.withValues(alpha: 0.25),
+                          borderRadius: BorderRadius.circular(8),
+                        ),
+                        child: SelectableText(lines.join('\n'),
+                            style: const TextStyle(fontSize: 9.5, height: 1.5, color: AppColors.text, fontFamily: 'monospace')),
+                      )
+                    : const SizedBox(width: double.infinity, height: 0),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
 
