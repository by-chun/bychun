- 容器列表每项加 Switch = 设为默认环境（必须保留一个）
- 移除启动时 seedDefaultPlugins，内置插件改为按需手动安装
- 版本 6.4.3+643（仅本地提交）
---
 lib/agent/agent_engine.dart   |  4 +---
 lib/pages/container_page.dart | 11 +++++++++++
 pubspec.yaml                  |  2 +-
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/lib/agent/agent_engine.dart b/lib/agent/agent_engine.dart
index 027107e..cf41c23 100644
--- a/lib/agent/agent_engine.dart
+++ b/lib/agent/agent_engine.dart
@@ -355,9 +355,7 @@ class AgentEngine extends ChangeNotifier implements LiveShellSink {
       _skillsText = sk.map((s) => '- ${s.name}: ${s.description}').join('\n');
       _subsText = sa.map((a) => '- ${a.name}(${a.modelTier}): ${a.description}').join('\n');
     } catch (_) {}
-    try {
-      await seedDefaultPlugins();
-    } catch (_) {}
+    // 不再自动写入内置插件；需要时在插件页手动安装
     try {
       _promptText = await PromptStore.activeContent();
     } catch (_) {}
diff --git a/lib/pages/container_page.dart b/lib/pages/container_page.dart
index 6e6726f..3c0b7f1 100644
--- a/lib/pages/container_page.dart
+++ b/lib/pages/container_page.dart
@@ -298,6 +298,17 @@ class _ContainerPageState extends State<ContainerPage> {
               ],
             ),
           ),
+          Switch(
+            value: isCurrent,
+            activeColor: AppColors.brand,
+            onChanged: ready
+                ? (v) async {
+                    if (!v) return; // 必须保留一个默认环境
+                    await NativeBridge.envSet(name);
+                    await _load();
+                  }
+                : null,
+          ),
           IconButton(
             onPressed: () => _remove(name),
             icon: const Icon(Icons.delete_outline_rounded, size: 18),
diff --git a/pubspec.yaml b/pubspec.yaml
index daf9023..3d314e9 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: 'none' # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
 # In Windows, build-name is used as the major, minor, and patch parts
 # of the product and file versions while build-number is used as the build suffix.
-version: 6.4.2+642
+version: 6.4.3+643
 
 environment:
   sdk: ^3.9.2
