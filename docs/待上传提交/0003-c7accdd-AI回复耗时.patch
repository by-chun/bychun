- ChatMsg 增加 elapsedMs；_runLoop 记录流式请求开始/结束时间
- AI 气泡底部显示「用时 2.4s」（超过 10s 显示整数秒）
- 版本 6.2.3+623（仅本地提交）
---
 lib/agent/agent_engine.dart | 14 ++++++++++++--
 lib/pages/chat_message.dart | 11 ++++++++++-
 lib/pages/chat_page.dart    |  2 +-
 pubspec.yaml                |  2 +-
 4 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/lib/agent/agent_engine.dart b/lib/agent/agent_engine.dart
index 14ead89..b852026 100644
--- a/lib/agent/agent_engine.dart
+++ b/lib/agent/agent_engine.dart
@@ -42,6 +42,9 @@ class ChatMsg {
   final String? viewTitle;
   final Map<String, dynamic>? viewData;
 
+  /// assistant 消息的生成耗时（毫秒）。
+  final int? elapsedMs;
+
   const ChatMsg(
     this.role,
     this.text, {
@@ -50,6 +53,7 @@ class ChatMsg {
     this.view,
     this.viewTitle,
     this.viewData,
+    this.elapsedMs,
   });
 }
 
@@ -491,11 +495,13 @@ class AgentEngine extends ChangeNotifier {
       streaming = true;
       streamingText = '';
       notifyListeners();
+      final t0 = DateTime.now();
       final resp = await _llm!.chatStream(api, tools, onDelta: (d) {
         streamingText += d;
         notifyListeners();
       });
       final streamed = streamingText;
+      final tookMs = DateTime.now().difference(t0).inMilliseconds;
       streaming = false;
       streamingText = '';
       notifyListeners();
@@ -508,7 +514,9 @@ class AgentEngine extends ChangeNotifier {
         return;
       }
       if (resp.toolCalls.isEmpty) {
-        if (streamed.trim().isNotEmpty) _add(ChatMsg('assistant', streamed));
+        if (streamed.trim().isNotEmpty) {
+          _add(ChatMsg('assistant', streamed, elapsedMs: tookMs));
+        }
         return;
       }
       final tcJson = resp.toolCalls
@@ -519,7 +527,9 @@ class AgentEngine extends ChangeNotifier {
               })
           .toList();
       api.add({'role': 'assistant', 'content': streamed, 'tool_calls': tcJson});
-      if (streamed.trim().isNotEmpty) _add(ChatMsg('assistant', streamed));
+      if (streamed.trim().isNotEmpty) {
+        _add(ChatMsg('assistant', streamed, elapsedMs: tookMs));
+      }
       for (final tc in resp.toolCalls) {
         final tool = registry.get(tc.name);
         _add(ChatMsg('tool', '调用 ${tc.name} ${tc.args}', toolName: tc.name));
diff --git a/lib/pages/chat_message.dart b/lib/pages/chat_message.dart
index 8600d70..f08b9d1 100644
--- a/lib/pages/chat_message.dart
+++ b/lib/pages/chat_message.dart
@@ -93,7 +93,8 @@ class UserBubble extends StatelessWidget {
 class AssistantBubble extends StatelessWidget {
   final String text;
   final bool typing;
-  const AssistantBubble({super.key, required this.text, this.typing = false});
+  final int? elapsedMs;
+  const AssistantBubble({super.key, required this.text, this.typing = false, this.elapsedMs});
 
   @override
   Widget build(BuildContext context) {
@@ -165,6 +166,14 @@ class AssistantBubble extends StatelessWidget {
                     )
             else
               CodeCard(code: blocks[i].text, lang: blocks[i].code!),
+          if (elapsedMs != null)
+            Padding(
+              padding: const EdgeInsets.only(top: 6),
+              child: Text(
+                '用时 ${(elapsedMs! / 1000).toStringAsFixed(elapsedMs! >= 10000 ? 0 : 1)}s',
+                style: const TextStyle(fontSize: 9.5, color: AppColors.muted),
+              ),
+            ),
         ],
         ),
       ),
diff --git a/lib/pages/chat_page.dart b/lib/pages/chat_page.dart
index 7ec663a..426d247 100644
--- a/lib/pages/chat_page.dart
+++ b/lib/pages/chat_page.dart
@@ -82,7 +82,7 @@ class _ChatPageState extends ConsumerState<ChatPage> {
   Widget _renderItem(ChatItem item, AgentEngine engine) {
     final w = switch (item) {
       UserItem u => UserBubble(text: u.msg.text),
-      AssistantItem a => AssistantBubble(text: a.msg.text, typing: a.typing),
+      AssistantItem a => AssistantBubble(text: a.msg.text, typing: a.typing, elapsedMs: a.msg.elapsedMs),
       ToolGroupItem g => ToolGroupTile(tools: g.tools),
       ViewItem v => ViewCard(
           view: v.msg.view ?? '',
