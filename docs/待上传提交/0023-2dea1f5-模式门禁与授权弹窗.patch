           r = ToolResult(false, '未知工具 ${tc.name}');
         } else {
-          final decision = policy.check(tool.name, tc.args);
+          final decision = policy.check(tool.name, tc.args, mode: mode);
           if (decision == 'deny') {
-            r = ToolResult(false, '被权限规则拒绝：${tool.name}（可在 设置→工具授权 调整）');
+            r = ToolResult(
+                false,
+                mode == 'plan'
+                    ? '规划模式只读：${tool.name} 会改东西，已拦下。要动手请把模式切到「执行」或「自动」'
+                    : '被权限规则拒绝：${tool.name}（可在 设置 → 权限 里调整）');
           } else if (decision == 'confirm') {
             final pending = PendingPermission(tool.name, tc.args);
             pendingPermission = pending;
diff --git a/lib/agent/permission.dart b/lib/agent/permission.dart
index 05adcaa..e013d59 100644
--- a/lib/agent/permission.dart
+++ b/lib/agent/permission.dart
@@ -39,18 +39,49 @@ class PermissionPolicy {
 
   static bool isHighRisk(String tool) => highRisk.contains(tool) || tool.startsWith('root');
 
-  /// 返回 allow / deny / confirm。未记录的默认 confirm（每次先问，但不进规则列表）。
-  String check(String tool, Map<String, String> args) {
+  /// 只读工具：规划模式下只允许这些。
+  static const Set<String> readOnlyTools = {
+    'readFile',
+    'listFiles',
+    'listApps',
+    'listContainers',
+    'listPlugins',
+    'captureList',
+    'captureLog',
+    'mcpList',
+    'webSearch',
+    'fetchPage',
+    'readConfig',
+    'memoryRead',
+    'memScan',
+    'memHits',
+    'memBreakpointList',
+    'listSkills',
+    'listSubAgents',
+  };
+
+  /// 返回 allow / deny / confirm。
+  ///
+  /// mode:
+  /// - build（执行）：所有工具都先问
+  /// - plan（规划）：只读工具直接放行，写操作直接拒结
+  /// - auto（自动）：除高危外都不问
+  String check(String tool, Map<String, String> args, {String mode = 'build'}) {
     final cmd = args['cmd'] ?? '';
     if (_hit(deny, tool, cmd)) return 'deny';
-    // 高危操作不管有没有「始终允许」记录，一律重新问
+    if (mode == 'plan') {
+      return readOnlyTools.contains(tool) ? 'allow' : 'deny';
+    }
+    // 高危操作不管什么模式、有没有「始终允许」记录，一律重新问
     if (isHighRisk(tool)) return 'confirm';
+    if (mode == 'auto') return 'allow';
     if (_hit(confirm, tool, cmd)) return 'confirm';
     if (_hit(allow, tool, cmd)) return 'allow';
     return 'confirm';
   }
 
-  bool allowTool(String tool, Map<String, String> args) => check(tool, args) == 'allow';
+  bool allowTool(String tool, Map<String, String> args, {String mode = 'build'}) =>
+      check(tool, args, mode: mode) == 'allow';
 
   // ---------- 持久化 ----------
   static Future<File?> _file() async {
