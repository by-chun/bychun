+                  Text(
+                    v ?? '—',
+                    style: TextStyle(
+                      fontSize: 12,
+                      fontWeight: FontWeight.w700,
+                      color: v == null ? AppColors.muted : AppColors.brand,
+                    ),
+                  ),
+                ]),
+              ),
+            ]),
             const SizedBox(height: 8),
             if (models.isEmpty)
               const Padding(
@@ -1078,7 +1115,10 @@ class _ChatPageState extends ConsumerState<ChatPage> {
