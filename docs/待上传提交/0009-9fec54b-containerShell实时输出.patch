AI 更常用 containerShell，之前只有 shell 走流式，所以下载/安装看不到进度。
- tool.dart 新增 LiveShellSink 接口（避免 agent_engine 与 tools_mcp 循环依赖）
- AgentEngine 实现 LiveShellSink；ShellTool 改用接口
- ContainerShellTool 注入 sink，走 streamExec 实时推送到对话卡片 + 180s 超时
- 版本 6.2.9+629（仅本地提交）
---
 lib/agent/agent_engine.dart |  6 +++---
 lib/agent/tool.dart         |  7 +++++++
 lib/agent/tools_mcp.dart    | 20 ++++++++++++++++++++
 pubspec.yaml                |  2 +-
 4 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/lib/agent/agent_engine.dart b/lib/agent/agent_engine.dart
index f848dc3..d7faf43 100644
--- a/lib/agent/agent_engine.dart
+++ b/lib/agent/agent_engine.dart
@@ -57,7 +57,7 @@ class ChatMsg {
   });
 }
 
-class AgentEngine extends ChangeNotifier {
+class AgentEngine extends ChangeNotifier implements LiveShellSink {
   final ToolRegistry registry = ToolRegistry();
   final MemoryStore memory = MemoryStore();
   String? workspace;
@@ -272,7 +272,7 @@ class AgentEngine extends ChangeNotifier {
     registry.register(McpListTool());
     registry.register(McpCallTool());
     registry.register(GitExecTool());
-    registry.register(ContainerShellTool());
+    registry.register(ContainerShellTool(this));
     registry.register(InstallContainerTool());
     registry.register(ListContainersTool());
     registry.register(CaptureStartTool());
@@ -755,7 +755,7 @@ class RootShellTool extends AgentTool {
 }
 
 class ShellTool extends AgentTool {
-  final AgentEngine? engine;
+  final LiveShellSink? engine;
   ShellTool([this.engine]);
   @override
   String get name => 'shell';
diff --git a/lib/agent/tool.dart b/lib/agent/tool.dart
index 20f995b..92ad0b5 100644
--- a/lib/agent/tool.dart
+++ b/lib/agent/tool.dart
@@ -44,6 +44,13 @@ List<String> terminalLines(
   return lines;
 }
 
+/// 实时命令输出的接收方（UI 渲染成 stream 卡片）。
+abstract class LiveShellSink {
+  void startLive(String title);
+  void pushLive(String line);
+  void endLive(int code);
+}
+
 abstract class AgentTool {
   String get name;
   String get description;
diff --git a/lib/agent/tools_mcp.dart b/lib/agent/tools_mcp.dart
index e8b79f1..be8f74a 100644
--- a/lib/agent/tools_mcp.dart
+++ b/lib/agent/tools_mcp.dart
@@ -59,6 +59,8 @@ class McpCallTool extends AgentTool {
 }
 
 class ContainerShellTool extends AgentTool {
+  final LiveShellSink? sink;
+  ContainerShellTool([this.sink]);
   @override
   String get name => 'containerShell';
   @override
@@ -69,6 +71,24 @@ class ContainerShellTool extends AgentTool {
   Future<ToolResult> execute(Map<String, String> args) async {
     final cmd = args['cmd'] ?? '';
     if (cmd.isEmpty) return const ToolResult(false, 'cmd 为空');
+    // 有 sink 就走流式：对话里能实时看到输出与耗时
+    if (sink != null) {
+      final tag = 'cs${DateTime.now().microsecondsSinceEpoch}';
+      sink!.startLive(cmd);
+      final sub = NativeBridge.outputStream.listen((e) {
+        if (e['tag'] == tag && e['line'] != null) sink!.pushLive('${e['line']}');
+      });
+      var code = -1;
+      try {
+        code = await NativeBridge.streamExec(cmd, tag: tag)
+            .timeout(const Duration(seconds: 180), onTimeout: () => -1);
+      } catch (_) {
+      } finally {
+        await sub.cancel();
+      }
+      sink!.endLive(code);
+      return ToolResult(code == 0, '命令结束，exit $code（输出见上方终端卡片）');
+    }
     final r = await NativeBridge.prootExec(cmd);
     final out = '${r.stdout}${r.stderr}'.trim();
     return ToolResult(
