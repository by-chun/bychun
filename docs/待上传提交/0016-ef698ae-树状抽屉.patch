+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../theme/app_theme.dart';
+import '../native/native_bridge.dart';
+import '../state/chat_refs.dart';
+import '../pages/settings_page.dart';
+import '../pages/personas_page.dart';
+import '../pages/container_page.dart';
+import '../pages/compact_page.dart';
+import '../pages/backup_page.dart';
+
+/// 抽屉里的树状工作区：应用 / 文件 / 插件 / 设置，逐级向下展开。
+class TreeDrawer extends ConsumerStatefulWidget {
+  final void Function(Widget page) onOpenPage;
+  final VoidCallback? onClose;
+  const TreeDrawer({super.key, required this.onOpenPage, this.onClose});
+
+  @override
+  ConsumerState<TreeDrawer> createState() => _TreeDrawerState();
+}
+
+class _TreeDrawerState extends ConsumerState<TreeDrawer> {
+  final Set<String> _open = {};
+  String _q = '';
+  List<Map<String, dynamic>>? _apps;
+  final Map<String, List<(String, bool)>> _dirs = {};
+
+  bool _isOpen(String k) => _open.contains(k);
+
+  void _toggle(String k) async {
+    setState(() {
+      if (_open.contains(k)) {
+        _open.remove(k);
+      } else {
+        _open.add(k);
+      }
+    });
+    if (_open.contains(k)) await _ensure(k);
+  }
+
+  Future<void> _ensure(String key) async {
+    if (key == 'apps' && _apps == null) {
+      final l = await NativeBridge.listApps();
+      if (mounted) setState(() => _apps = l);
+    }
+  }
+
+  Future<List<(String, bool)>> _ls(String path) async {
+    if (_dirs.containsKey(path)) return _dirs[path]!;
+    await NativeBridge.requestStorage();
+    final r = await NativeBridge.exec("ls -1ap '${path.replaceAll("'", "'\\''")}'");
+    final items = <(String, bool)>[];
+    if (r.ok) {
+      for (final line in r.stdout.split('\n')) {
+        final t = line.trim();
+        if (t.isEmpty || t == './' || t == '../') continue;
+        items.add((t.endsWith('/') ? t.substring(0, t.length - 1) : t, t.endsWith('/')));
+      }
+    }
+    items.sort((a, b) {
+      if (a.$2 != b.$2) return a.$2 ? -1 : 1;
+      return a.$1.toLowerCase().compareTo(b.$1.toLowerCase());
+    });
+    _dirs[path] = items;
+    return items;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      color: AppColors.bg,
+      child: SafeArea(
+        child: Column(
+          children: [
+            Padding(
+              padding: const EdgeInsets.fromLTRB(18, 14, 18, 8),
+              child: Row(
+                children: [
+                  const Text('工作区',
+                      style: TextStyle(fontSize: 17, fontWeight: FontWeight.w800, color: Color(0xFF0F172A))),
+                  const Spacer(),
+                  if (widget.onClose != null)
+                    InkWell(
+                      onTap: widget.onClose,
+                      borderRadius: BorderRadius.circular(8),
+                      child: const Padding(
+                        padding: EdgeInsets.all(6),
+                        child: Icon(Icons.close_rounded, size: 18, color: Color(0xFF94A3B8)),
+                      ),
+                    ),
+                ],
+              ),
+            ),
+            Expanded(
+              child: ListView(
+                padding: const EdgeInsets.fromLTRB(12, 0, 12, 20),
+                children: [
+                  _card([_section('apps', '应用', _typeIcon(Icons.grid_view_rounded), const Color(0xFF2563EB))]),
+                  _appChildren(),
+                  const SizedBox(height: 6),
+                  _card([
+                    _section('files', '文件', _typeIcon(Icons.folder_outlined), const Color(0xFF64748B)),
+                    if (_isOpen('files')) _searchAdd('files', onAdd: null),
+                    if (_isOpen('files')) _dirChildren('files', '/storage/emulated/0', 1),
+                  ]),
+                  const SizedBox(height: 6),
+                  _card([
+                    _section('plugins', '插件', _typeIcon(Icons.extension_outlined), const Color(0xFF64748B)),
+                    if (_isOpen('plugins')) _searchAdd('plugins', onAdd: null),
+                    if (_isOpen('plugins')) _dirChildren('plugins', '/storage/emulated/0/G/plugins', 1),
+                  ]),
+                  const SizedBox(height: 6),
+                  _card(_settingRows()),
+                ],
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _card(List<Widget> children) {
+    return Container(
+      decoration: BoxDecoration(
+        color: Colors.white,
+        borderRadius: BorderRadius.circular(14),
+        boxShadow: const [BoxShadow(color: Color(0x0A0F172A), blurRadius: 10, offset: Offset(0, 2))],
+      ),
+      child: Column(children: children),
+    );
+  }
+
+  Widget _typeIcon(IconData ic, {bool open = false}) => Icon(
+        ic,
+        size: 18,
+        color: const Color(0xFF2563EB),
+      );
+
+  Widget _section(String key, String title, Widget icon, Color? _) {
+    final open = _isOpen(key);
+    return InkWell(
+      onTap: () => _toggle(key),
+      child: Padding(
+        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 11),
+        child: Row(
+          children: [
+            SizedBox(
+              width: 10,
+              child: Icon(open ? Icons.keyboard_arrow_down_rounded : Icons.keyboard_arrow_right_rounded,
+                  size: 14, color: const Color(0xFFC3CCD8)),
+            ),
+            const SizedBox(width: 6),
+            icon,
+            const SizedBox(width: 8),
+            Text(title, style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w700, color: Color(0xFF0F172A))),
+            const Spacer(),
+            if (key == 'apps' && _apps != null)
+              Text('${_apps!.length}',
+                  style: const TextStyle(fontSize: 10, color: Color(0xFFC3CCD8), fontFamily: 'monospace')),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _searchAdd(String key, {VoidCallback? onAdd}) {
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(24, 0, 8, 8),
+      child: Row(
+        children: [
+          Expanded(
+            child: Container(
+              height: 32,
+              padding: const EdgeInsets.symmetric(horizontal: 10),
+              decoration: BoxDecoration(
+                color: const Color(0xFFF7F8FA),
+                borderRadius: BorderRadius.circular(16),
+                border: Border.all(color: const Color(0xFFEEF2F7)),
+              ),
+              child: Row(
+                children: [
+                  const Icon(Icons.search_rounded, size: 13, color: Color(0xFF94A3B8)),
+                  const SizedBox(width: 6),
+                  Expanded(
+                    child: TextField(
+                      onChanged: (v) => setState(() => _q = v),
+                      style: const TextStyle(fontSize: 11.5),
+                      decoration: const InputDecoration(
+                        isDense: true,
+                        border: InputBorder.none,
+                        hintText: '搜索',
+                        hintStyle: TextStyle(fontSize: 11.5, color: Color(0xFF94A3B8)),
+                      ),
+                    ),
+                  ),
+                ],
+              ),
+            ),
+          ),
+          if (onAdd != null) ...[
+            const SizedBox(width: 6),
+            InkWell(
+              onTap: onAdd,
+              borderRadius: BorderRadius.circular(16),
+              child: Container(
+                width: 32,
+                height: 32,
+                decoration: const BoxDecoration(color: Color(0xFF2563EB), shape: BoxShape.circle),
+                child: const Icon(Icons.add_rounded, size: 17, color: Colors.white),
+              ),
+            ),
+          ],
+        ],
+      ),
+    );
+  }
+
+  // ---------------- 应用 ----------------
+  List<Widget> _appChildren() {
+    if (!_isOpen('apps')) return const [];
+    final apps = _apps;
+    if (apps == null) {
+      return const [
+        Padding(padding: EdgeInsets.all(14), child: Center(child: SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2)))),
+      ];
+    }
+    final q = _q.toLowerCase();
+    final list = q.isEmpty
+        ? apps
+        : apps.where((a) {
+            final l = (a['label'] ?? '').toString().toLowerCase();
+            final p = (a['package'] ?? '').toString().toLowerCase();
+            return l.contains(q) || p.contains(q);
+          }).toList();
+    return [
+      _searchAdd('apps'),
+      ...list.take(80).map(_appRow),
+    ];
+  }
+
+  Widget _appRow(Map<String, dynamic> a) {
+    final label = (a['label'] ?? '?').toString();
+    final pkg = (a['package'] ?? '').toString();
+    final key = 'app:$pkg';
+    final open = _isOpen(key);
+    final color = _colorOf(label);
+    return _draggableRow(
+      ref: ChatRef(type: 'app', name: label, detail: pkg),
+      onTap: () => _toggle(key),
+      onLongPress: () => _rowMenu(
+        title: label,
+        onRename: null,
+        onDelete: null,
+      ),
+      child: Column(
+        children: [
+          Row(
+            children: [
+              SizedBox(
+                width: 10,
+                child: Icon(open ? Icons.keyboard_arrow_down_rounded : Icons.keyboard_arrow_right_rounded,
+                    size: 14, color: const Color(0xFFC3CCD8)),
+              ),
+              const SizedBox(width: 6),
+              Container(
+                width: 20,
+                height: 20,
+                decoration: BoxDecoration(color: color, borderRadius: BorderRadius.circular(6)),
+                child: Center(
+                  child: Text(label.isEmpty ? '?' : label.substring(0, 1),
+                      style: const TextStyle(color: Colors.white, fontSize: 10, fontWeight: FontWeight.w700)),
+                ),
+              ),
+              const SizedBox(width: 8),
+              Expanded(
+                child: Text(label,
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: const TextStyle(fontSize: 12.5, fontWeight: FontWeight.w500)),
+              ),
+              const Icon(Icons.drag_handle_rounded, size: 14, color: Color(0xFFE2E8F0)),
+            ],
+          ),
+          if (open)
+            Padding(
+              padding: const EdgeInsets.fromLTRB(42, 4, 8, 6),
+              child: Column(
+                children: [
+                  _kvLine('APK', _size((a['size'] as num?)?.toInt() ?? 0)),
+                  _kvLine('路径', (a['apk'] ?? '—').toString()),
+                  _kvLine('类型', a['system'] == true ? '系统应用' : '用户应用'),
+                ],
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+
+  Widget _kvLine(String k, String v) => Padding(
+        padding: const EdgeInsets.symmetric(vertical: 2),
+        child: Row(
+          children: [
+            SizedBox(width: 34, child: Text(k, style: const TextStyle(fontSize: 9.5, color: Color(0xFFB6C0CD)))),
+            Expanded(
+              child: Text(v,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  style: const TextStyle(fontSize: 9.5, color: Color(0xFF64748B), fontFamily: 'monospace')),
+            ),
+          ],
+        ),
+      );
+
+  // ---------------- 目录（文件 / 插件） ----------------
+  Widget _dirChildren(String rootKey, String path, int depth) {
+    return FutureBuilder<List<(String, bool)>>(
+      future: _ls(path),
+      builder: (context, snap) {
+        final items = snap.data;
+        if (items == null) {
+          return const Padding(
+            padding: EdgeInsets.all(12),
+            child: Center(child: SizedBox(width: 14, height: 14, child: CircularProgressIndicator(strokeWidth: 2))),
+          );
+        }
+        final q = _q.toLowerCase();
+        final list = q.isEmpty ? items : items.where((e) => e.$1.toLowerCase().contains(q)).toList();
+        if (list.isEmpty) {
+          return const Padding(
+            padding: EdgeInsets.fromLTRB(34, 6, 10, 12),
+            child: Text('（空）', style: TextStyle(fontSize: 10.5, color: Color(0xFF94A3B8))),
+          );
+        }
+        return Column(children: [
+          for (final e in list.take(depth == 1 ? 40 : 60)) _fsRow(root, path, e.$1, e.$2, depth),
+        ]);
+      },
+    );
+  }
+
+  Widget _fsRow(String rootKey, String parent, String name, bool isDir, int depth) {
+    final full = '$parent/$name';
+    final key = 'fs:$full';
+    final open = _isOpen(key);
+    final ext = name.contains('.') ? name.split('.').last.toLowerCase() : '';
+    return Column(
+      children: [
+        _draggableRow(
+          ref: ChatRef(type: 'file', name: name, detail: full),
+          onTap: () => _toggle(key),
+          onLongPress: () => _rowMenu(
+            title: name,
+            onRename: () => _rename(full),
+            onDelete: () => _delete(full),
+          ),
+          child: Row(
+            children: [
+              SizedBox(
+                width: 10,
+                child: Icon(open ? Icons.keyboard_arrow_down_rounded : Icons.keyboard_arrow_right_rounded,
+                    size: 14, color: const Color(0xFFC3CCD8)),
+              ),
+              const SizedBox(width: 6),
+              Icon(
+                isDir ? Icons.folder_outlined : Icons.description_outlined,
+                size: 17,
+                color: isDir ? const Color(0xFF64748B) : const Color(0xFF94A3B8),
+              ),
+              const SizedBox(width: 8),
+              Expanded(
+                child: Text(name,
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: TextStyle(
+                        fontSize: isDir ? 12.5 : 12,
+                        fontFamily: isDir ? null : 'monospace',
+                        fontWeight: isDir ? FontWeight.w600 : FontWeight.w500)),
+              ),
+              if (ext == 'sh' || ext == 'py' || ext == 'js')
+                Container(
+                  padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 1),
+                  decoration: BoxDecoration(color: const Color(0xFFECFDF5), borderRadius: BorderRadius.circular(3)),
+                  child: Text(ext, style: const TextStyle(fontSize: 8, color: Color(0xFF16A34A), fontWeight: FontWeight.w700)),
+                ),
+              const SizedBox(width: 4),
+              const Icon(Icons.drag_handle_rounded, size: 14, color: Color(0xFFE2E8F0)),
+            ],
+          ),
+        ),
+        if (open && isDir) Padding(padding: const EdgeInsets.only(left: 16), child: _dirChildren(rootKey, full, depth + 1)),
+      ],
+    );
+  }
+
+  Widget _draggableRow({
+    required ChatRef ref,
+    required Widget child,
+    VoidCallback? onTap,
+    VoidCallback? onLongPress,
+  }) {
+    return LongPressDraggable<ChatRef>(
+      data: ref,
+      delay: const Duration(milliseconds: 220),
+      feedback: Material(
+        color: Colors.transparent,
+        child: Container(
+          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+          decoration: BoxDecoration(color: AppColors.brand, borderRadius: BorderRadius.circular(10)),
+          child: Text(ref.name, style: const TextStyle(color: Colors.white, fontSize: 11.5)),
+        ),
+      ),
+      childWhenDragging: Opacity(opacity: 0.4, child: child),
+      child: InkWell(
+        onTap: onTap,
+        onLongPress: onLongPress,
+        borderRadius: BorderRadius.circular(8),
+        child: Padding(padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 8), child: child),
+      ),
+    );
+  }
+
+  Future<void> _rowMenu({required String title, VoidCallback? onRename, VoidCallback? onDelete}) async {
+    final act = await showModalBottomSheet<String>(
+      context: context,
+      backgroundColor: Colors.white,
+      shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(18))),
+      builder: (ctx) => SafeArea(
+        child: Column(mainAxisSize: MainAxisSize.min, children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(18, 14, 18, 6),
+            child: Row(children: [
+              Expanded(
+                  child: Text(title,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: const TextStyle(fontSize: 12, color: Color(0xFF94A3B8), fontFamily: 'monospace'))),
+            ]),
+          ),
+          if (onRename != null)
+            ListTile(
+              leading: const Icon(Icons.drive_file_rename_outline_rounded, size: 20),
+              title: const Text('重命名', style: TextStyle(fontSize: 13.5)),
+              onTap: () => Navigator.pop(ctx, 'rename'),
+            ),
+          ListTile(
+            leading: const Icon(Icons.arrow_outward_rounded, size: 20),
+            title: const Text('发到对话', style: TextStyle(fontSize: 13.5)),
+            onTap: () => Navigator.pop(ctx, 'chat'),
+          ),
+          if (onDelete != null)
+            ListTile(
+              leading: const Icon(Icons.delete_outline_rounded, size: 20, color: Color(0xFFDC2626)),
+              title: const Text('删除', style: TextStyle(fontSize: 13.5, color: Color(0xFFDC2626))),
+              onTap: () => Navigator.pop(ctx, 'delete'),
+            ),
+        ]),
+      ),
+    );
+    if (act == 'rename') onRename?.call();
+    if (act == 'delete') onDelete?.call();
+  }
+
+  Future<void> _rename(String full) async {
+    final name = full.split('/').last;
+    final c = TextEditingController(text: name);
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: Colors.white,
+        title: const Text('重命名', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+        content: TextField(controller: c, autofocus: true),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+          FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('确定')),
+        ],
+      ),
+    );
+    final newName = c.text.trim();
+    c.dispose();
+    if (ok != true || newName.isEmpty || newName == name) return;
+    final dir = full.substring(0, full.lastIndexOf('/'));
+    await NativeBridge.exec("mv '${full.replaceAll("'", "'\\''")}' '${dir.replaceAll("'", "'\\''")}/$newName'");
+    _dirs.remove(dir);
+    if (mounted) setState(() {});
+  }
+
+  Future<void> _delete(String full) async {
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: Colors.white,
+        title: const Text('删除', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+        content: Text(full, style: const TextStyle(fontSize: 11.5, fontFamily: 'monospace')),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+          FilledButton(
+            style: FilledButton.styleFrom(backgroundColor: const Color(0xFFDC2626)),
+            onPressed: () => Navigator.pop(ctx, true),
+            child: const Text('删除'),
+          ),
+        ],
+      ),
+    );
+    if (ok != true) return;
+    await NativeBridge.exec("rm -rf '${full.replaceAll("'", "'\\''")}'");
+    _dirs.clear();
+    if (mounted) setState(() {});
+  }
+
+  // ---------------- 设置 ----------------
+  List<Widget> _settingRows() {
+    final open = _isOpen('settings');
+    return [
+      _section('settings', '设置', _typeIcon(Icons.settings_outlined), const Color(0xFF2563EB)),
+      if (open) ...[
+        _settingItem('AI 供应商', const ProvidersPage()),
+        _settingItem('人物', const PersonasPage()),
+        _settingItem('子代理', const SkillsSubPage()),
+        _settingItem('容器', const ContainerPage()),
+        _settingItem('权限', const PowerPage()),
+        _settingItem('上下文压缩', const CompactPage()),
+        _settingItem('备份与恢复', const BackupPage()),
+      ],
+    ];
+  }
+
+  Widget _settingItem(String title, Widget page) {
+    return InkWell(
+      onTap: () => widget.onOpenPage(page),
+      child: Padding(
+        padding: const EdgeInsets.fromLTRB(34, 9, 12, 9),
+        child: Row(children: [
+          Text(title, style: const TextStyle(fontSize: 12.5, color: Color(0xFF334155))),
+          const Spacer(),
+          const Icon(Icons.chevron_right_rounded, size: 15, color: Color(0xFFC3CCD8)),
+        ]),
+      ),
+    );
+  }
+
+  static Color _colorOf(String s) {
+    const cs = [Color(0xFF22C55E), Color(0xFF0EA5E9), Color(0xFF2563EB), Color(0xFF7C3AED), Color(0xFFF59E0B)];
+    return cs[s.isEmpty ? 0 : s.codeUnitAt(0) % cs.length];
+  }
+
+  static String _size(int b) {
+    if (b >= 1024 * 1024 * 1024) return '${(b / 1024 / 1024 / 1024).toStringAsFixed(1)}GB';
+    if (b >= 1024 * 1024) return '${(b / 1024 / 1024).toStringAsFixed(0)}MB';
+    if (b >= 1024) return '${(b / 1024).toStringAsFixed(0)}KB';
+    return '${b}B';
+  }
+}
