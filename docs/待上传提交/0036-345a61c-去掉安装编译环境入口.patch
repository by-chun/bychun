- 删除「安装编译环境」卡片与 _installToolchain（编译链由 AI 在容器里自行 apk add）
- 平台仍不内置任何镜像，安装来源只有 URL 与本地文件
- 版本 6.9.7+697（仅本地）
---
 lib/pages/container_page.dart | 41 -----------------------------------
 pubspec.yaml                  |  2 +-
 2 files changed, 1 insertion(+), 42 deletions(-)

diff --git a/lib/pages/container_page.dart b/lib/pages/container_page.dart
index 2b58c3f..26bd315 100644
--- a/lib/pages/container_page.dart
+++ b/lib/pages/container_page.dart
@@ -86,35 +86,6 @@ class _ContainerPageState extends State<ContainerPage> {
     _showResult(r);
   }
 
-  /// 在容器里装编译链：之后 AI 能直接编 arm64 二进制和 .so。
-  Future<void> _installToolchain() async {
-    setState(() => _busy = true);
-    ExecResult r;
-    try {
-      r = await NativeBridge.exec('apk add --no-cache build-base clang', timeout: 900);
-    } finally {
-      if (mounted) setState(() => _busy = false);
-    }
-    if (!mounted) return;
-    await showDialog<void>(
-      context: context,
-      builder: (ctx) => AlertDialog(
-        backgroundColor: Colors.white,
-        title: Text(r.ok ? '编译环境已装好' : '安装失败',
-            style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
-        content: SingleChildScrollView(
-          child: Text(
-            r.ok
-                ? '已安装：gcc / g++ / clang / make。\n之后 AI 可以直接编 arm64 二进制和 .so。'
-                : '${r.stderr}\n\n需要先在容器里装一个发行版（Alpine 等）。',
-            style: const TextStyle(fontSize: 11.5, height: 1.6),
-          ),
-        ),
-        actions: [TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('好'))],
-      ),
-    );
-  }
-
   Future<void> _import() async {
     final pathCtrl = TextEditingController(text: '/sdcard/Download/');
     final nameCtrl = TextEditingController();
@@ -240,18 +211,6 @@ class _ContainerPageState extends State<ContainerPage> {
                   ],
                 ),
               ),
-              const SizedBox(height: 8),
-              GlassCard(
-                onTap: _busy ? null : _installToolchain,
-                child: Row(
-                  children: const [
-                    Icon(Icons.construction_outlined, size: 18, color: AppColors.brand),
-                    SizedBox(width: 10),
-                    Expanded(child: Text('安装编译环境（gcc / g++ / clang / make）', style: TextStyle(fontSize: 13))),
-                    Icon(Icons.chevron_right, size: 18, color: Color(0xFFCBD5E1)),
-                  ],
-                ),
-              ),
               const SizedBox(height: 10),
               const Text(
                 '支持 tar / tar.gz / tar.xz（按文件头自动识别）。需要什么发行版就贴哪个的 arm64 rootfs 直链。',
diff --git a/pubspec.yaml b/pubspec.yaml
index 67745fb..05d94db 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: 'none' # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
 # In Windows, build-name is used as the major, minor, and patch parts
 # of the product and file versions while build-number is used as the build suffix.
-version: 6.9.6+696
+version: 6.9.7+697
 
 environment:
   sdk: ^3.9.2
