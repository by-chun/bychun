diff --git a/lib/widgets/capture_card.dart b/lib/widgets/capture_card.dart
new file mode 100644
index 0000000..1b2d424
--- /dev/null
+++ b/lib/widgets/capture_card.dart
@@ -0,0 +1,224 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import '../native/native_bridge.dart';
+import '../theme/app_theme.dart';
+
+/// 抓包窗口：AI 开始抓包后在对话里常驻，实时显示 DNS 记录。
+class CaptureCard extends StatefulWidget {
+  final Future<void> Function() onStop;
+  const CaptureCard({super.key, required this.onStop});
+
+  @override
+  State<CaptureCard> createState() => _CaptureCardState();
+}
+
+class _CaptureCardState extends State<CaptureCard> {
+  Timer? _timer;
+  List<CaptureHit> _hits = [];
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+    _timer = Timer.periodic(const Duration(milliseconds: 1500), (_) => _load());
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _load() async {
+    final text = await NativeBridge.vpnLog();
+    if (!mounted) return;
+    final hits = text
+        .split('\n')
+        .where((l) => l.trim().isNotEmpty)
+        .map(CaptureHit.parse)
+        .whereType<CaptureHit>()
+        .toList()
+        .reversed
+        .toList();
+    setState(() => _hits = hits);
+  }
+
+  Future<void> _clear() async {
+    await NativeBridge.vpnClear();
+    await _load();
+  }
+
+  void _expand() {
+    showModalBottomSheet<void>(
+      context: context,
+      backgroundColor: Colors.white,
+      isScrollControlled: true,
+      shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
+      builder: (ctx) => SizedBox(
+        height: MediaQuery.of(ctx).size.height * 0.7,
+        child: Column(
+          children: [
+            Padding(
+              padding: const EdgeInsets.fromLTRB(18, 16, 12, 6),
+              child: Row(children: [
+                const Text('抓包记录', style: TextStyle(fontSize: 14, fontWeight: FontWeight.w800)),
+                const SizedBox(width: 8),
+                Text('${_hits.length}',
+                    style: const TextStyle(fontSize: 10.5, color: Color(0xFF94A3B8), fontFamily: 'monospace')),
+                const Spacer(),
+                TextButton(onPressed: _clear, child: const Text('清空', style: TextStyle(fontSize: 12))),
+              ]),
+            ),
+            Expanded(
+              child: _hits.isEmpty
+                  ? const Center(
+                      child: Text('还没有抓到记录', style: TextStyle(fontSize: 12, color: Color(0xFF94A3B8))),
+                    )
+                  : ListView.separated(
+                      padding: const EdgeInsets.fromLTRB(14, 0, 14, 16),
+                      itemCount: _hits.length,
+                      separatorBuilder: (_, __) => const Divider(height: 1, color: Color(0xFFF1F5F9)),
+                      itemBuilder: (_, i) => _row(_hits[i], fontSize: 11.5),
+                    ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _row(CaptureHit h, {double fontSize = 10.5}) {
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 6),
+      child: Row(children: [
+        SizedBox(
+          width: 58,
+          child: Text(h.time,
+              style: const TextStyle(fontSize: 9.5, color: Color(0xFF94A3B8), fontFamily: 'monospace')),
+        ),
+        Expanded(
+          child: Text(h.host,
+              maxLines: 1,
+              overflow: TextOverflow.ellipsis,
+              style: TextStyle(fontSize: fontSize, fontFamily: 'monospace', color: const Color(0xFF334155))),
+        ),
+        if (h.ips.isNotEmpty) ...[
+          const SizedBox(width: 8),
+          Text(h.ips,
+              maxLines: 1,
+              overflow: TextOverflow.ellipsis,
+              style: const TextStyle(fontSize: 9.5, color: Color(0xFF16A34A), fontFamily: 'monospace')),
+        ],
+      ]),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final shown = _hits.take(6).toList();
+    return Container(
+      margin: const EdgeInsets.symmetric(vertical: 6),
+      decoration: BoxDecoration(
+        color: Colors.white,
+        borderRadius: BorderRadius.circular(16),
+        border: Border.all(color: const Color(0xFFE6EAF0)),
+        boxShadow: const [BoxShadow(color: Color(0x140F172A), blurRadius: 16, offset: Offset(0, 6))],
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(14, 12, 8, 8),
+            child: Row(children: [
+              Container(
+                width: 7,
+                height: 7,
+                decoration: const BoxDecoration(color: Color(0xFF16A34A), shape: BoxShape.circle),
+              ),
+              const SizedBox(width: 8),
+              const Text('抓包中', style: TextStyle(fontSize: 13, fontWeight: FontWeight.w800)),
+              const SizedBox(width: 8),
+              Text('${_hits.length}',
+                  style: const TextStyle(fontSize: 10.5, color: Color(0xFF94A3B8), fontFamily: 'monospace')),
+              const Spacer(),
+              IconButton(
+                onPressed: widget.onStop,
+                visualDensity: VisualDensity.compact,
+                icon: const Icon(Icons.close_rounded, size: 16, color: Color(0xFFCBD5E1)),
+              ),
+            ]),
+          ),
+          ConstrainedBox(
+            constraints: const BoxConstraints(minHeight: 96, maxHeight: 210),
+            child: shown.isEmpty
+                ? const Center(
+                    child: Text('等待流量…', style: TextStyle(fontSize: 11, color: Color(0xFF94A3B8))),
+                  )
+                : ListView(
+                    padding: const EdgeInsets.symmetric(horizontal: 14),
+                    shrinkWrap: true,
+                    children: [for (final h in shown) _row(h)],
+                  ),
+          ),
+          Padding(
+            padding: const EdgeInsets.fromLTRB(10, 8, 10, 10),
+            child: Row(children: [
+              Expanded(
+                child: _btn('停止', const Color(0xFFFEF2F2), const Color(0xFFDC2626), widget.onStop),
+              ),
+              const SizedBox(width: 8),
+              Expanded(
+                child: _btn('清空', const Color(0xFFF1F4F8), const Color(0xFF475569), _clear),
+              ),
+              const SizedBox(width: 8),
+              Expanded(
+                child: _btn('展开列表', AppColors.brand, Colors.white, () async => _expand()),
+              ),
+            ]),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _btn(String label, Color bg, Color fg, Future<void> Function() onTap) {
+    return InkWell(
+      onTap: () => onTap(),
+      borderRadius: BorderRadius.circular(10),
+      child: Container(
+        height: 34,
+        alignment: Alignment.center,
+        decoration: BoxDecoration(color: bg, borderRadius: BorderRadius.circular(10)),
+        child: Text(label, style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600, color: fg)),
+      ),
+    );
+  }
+}
+
+class CaptureHit {
+  final String time;
+  final String host;
+  final String ips;
+
+  CaptureHit(this.time, this.host, this.ips);
+
+  /// vpnLog 行格式：<毫秒时间戳> <域名> -> <ip,ip>
+  static CaptureHit? parse(String line) {
+    final idx = line.indexOf(' ');
+    if (idx <= 0) return null;
+    final ts = int.tryParse(line.substring(0, idx));
+    final rest = line.substring(idx + 1);
+    final arrow = rest.indexOf(' -> ');
+    if (arrow <= 0) return null;
+    final host = rest.substring(0, arrow).trim();
+    final ipText = rest.substring(arrow + 4).trim();
+    return CaptureHit(_fmt(ts), host, ipText == '?' ? '' : ipText);
+  }
+
+  static String _fmt(int? ms) {
+    if (ms == null) return '';
+    final d = DateTime.fromMillisecondsSinceEpoch(ms);
+    String two(int v) => v.toString().padLeft(2, '0');
+    return '${two(d.hour)}:${two(d.minute)}:${two(d.second)}';
+  }
+}
