+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../theme/app_theme.dart';
+import '../theme/glass.dart';
+import '../native/native_bridge.dart';
+import '../state/chat_refs.dart';
+
+/// 应用列表：只做「看信息 + 发到对话」，具体做什么由 AI 弹卡片决定。
+class AppsPage extends StatefulWidget {
+  const AppsPage({super.key});
+  @override
+  State<AppsPage> createState() => _AppsPageState();
+}
+
+class _AppsPageState extends State<AppsPage> {
+  List<Map<String, dynamic>>? _apps;
+  String _q = '';
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  Future<void> _load() async {
+    final l = await NativeBridge.listApps();
+    if (mounted) setState(() => _apps = l);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final apps = _apps;
+    return Scaffold(
+      backgroundColor: Colors.white,
+      appBar: AppBar(
+        leading: const BackButton(),
+        backgroundColor: Colors.white,
+        elevation: 0,
+        title: const Text('应用', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w800)),
+        actions: [
+          IconButton(onPressed: _load, icon: const Icon(Icons.refresh_rounded, size: 20),
+              color: const Color(0xFF94A3B8)),
+        ],
+      ),
+      body: apps == null
+          ? const Center(child: CircularProgressIndicator())
+          : Column(
+              children: [
+                Padding(
+                  padding: const EdgeInsets.fromLTRB(16, 4, 16, 8),
+                  child: TextField(
+                    onChanged: (v) => setState(() => _q = v),
+                    decoration: const InputDecoration(
+                      hintText: '搜索应用名 / 包名',
+                      prefixIcon: Icon(Icons.search_rounded, size: 18),
+                    ),
+                  ),
+                ),
+                Expanded(
+                  child: Builder(builder: (_) {
+                    final q = _q.toLowerCase();
+                    final list = q.isEmpty
+                        ? apps
+                        : apps.where((a) {
+                            final l = (a['label'] ?? '').toString().toLowerCase();
+                            final p = (a['package'] ?? '').toString().toLowerCase();
+                            return l.contains(q) || p.contains(q);
+                          }).toList();
+                    if (list.isEmpty) {
+                      return const Center(
+                          child: Text('没有匹配的应用', style: TextStyle(fontSize: 12, color: AppColors.muted)));
+                    }
+                    return ListView.builder(
+                      padding: const EdgeInsets.symmetric(horizontal: 16),
+                      itemCount: list.length,
+                      itemBuilder: (_, i) => _tile(list[i]),
+                    );
+                  }),
+                ),
+              ],
+            ),
+    );
+  }
+
+  Widget _tile(Map<String, dynamic> a) {
+    final label = (a['label'] ?? '?').toString();
+    final pkg = (a['package'] ?? '').toString();
+    final size = ((a['size'] as num?) ?? 0).toInt();
+    final sys = a['system'] == true;
+    return GlassCard(
+      margin: const EdgeInsets.only(bottom: 8),
+      onTap: () => Navigator.of(context).push(
+        MaterialPageRoute(builder: (_) => AppDetailPage(app: a)),
+      ),
+      child: Row(
+        children: [
+          Container(
+            width: 34,
+            height: 34,
+            decoration: BoxDecoration(
+              color: _color(label),
+              borderRadius: BorderRadius.circular(9),
+            ),
+            child: Center(
+              child: Text(label.isEmpty ? '?' : label.substring(0, 1),
+                  style: const TextStyle(color: Colors.white, fontSize: 14, fontWeight: FontWeight.w700)),
+            ),
+          ),
+          const SizedBox(width: 10),
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(label.isEmpty ? pkg : label,
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w600)),
+                const SizedBox(height: 2),
+                Text('$pkg · ${_size(size)}${sys ? ' · 系统' : ''}',
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: const TextStyle(fontSize: 9.5, color: AppColors.muted, fontFamily: 'monospace')),
+              ],
+            ),
+          ),
+          const Icon(Icons.chevron_right_rounded, size: 18, color: Color(0xFFCBD5E1)),
+        ],
+      ),
+    );
+  }
+
+  static Color _color(String s) {
+    const cs = [
+      Color(0xFF22C55E), Color(0xFF0EA5E9), Color(0xFF2563EB),
+      Color(0xFF7C3AED), Color(0xFFF59E0B), Color(0xFFEF4444),
+    ];
+    return cs[s.isEmpty ? 0 : s.codeUnitAt(0) % cs.length];
+  }
+
+  static String _size(int b) {
+    if (b >= 1024 * 1024 * 1024) return '${(b / 1024 / 1024 / 1024).toStringAsFixed(1)}GB';
+    if (b >= 1024 * 1024) return '${(b / 1024 / 1024).toStringAsFixed(0)}MB';
+    if (b >= 1024) return '${(b / 1024).toStringAsFixed(0)}KB';
+    return '${b}B';
+  }
+}
+
+/// 应用详情：只有信息 + 发到对话，没有任何固定功能按钮。
+class AppDetailPage extends ConsumerWidget {
+  final Map<String, dynamic> app;
+  const AppDetailPage({super.key, required this.app});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final label = (app['label'] ?? '').toString();
+    final pkg = (app['package'] ?? '').toString();
+    final apk = (app['apk'] ?? '').toString();
+    final size = ((app['size'] as num?) ?? 0).toInt();
+    final sys = app['system'] == true;
+
+    return Scaffold(
+      backgroundColor: Colors.white,
+      appBar: AppBar(
+        leading: const BackButton(),
+        backgroundColor: Colors.white,
+        elevation: 0,
+        title: Text(label.isEmpty ? pkg : label,
+            style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w800)),
+      ),
+      body: ListView(
+        padding: const EdgeInsets.all(16),
+        children: [
+          Row(
+            children: [
+              Container(
+                width: 52,
+                height: 52,
+                decoration: BoxDecoration(
+                  color: _AppsPageState._color(label),
+                  borderRadius: BorderRadius.circular(13),
+                ),
+                child: Center(
+                  child: Text(label.isEmpty ? '?' : label.substring(0, 1),
+                      style: const TextStyle(color: Colors.white, fontSize: 20, fontWeight: FontWeight.w700)),
+                ),
+              ),
+              const SizedBox(width: 12),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(label.isEmpty ? pkg : label,
+                        style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+                    const SizedBox(height: 3),
+                    Text(pkg,
+                        style: const TextStyle(fontSize: 10, color: AppColors.muted, fontFamily: 'monospace')),
+                  ],
+                ),
+              ),
+            ],
+          ),
+          const SizedBox(height: 18),
+          _kv('包名', pkg),
+          _kv('APK 路径', apk),
+          _kv('大小', _AppsPageState._size(size)),
+          _kv('类型', sys ? '系统应用' : '用户应用'),
+          const SizedBox(height: 20),
+          GlassCard(
+            onTap: () async {
+              ref.read(chatRefsProvider.notifier).add(ChatRef(
+                    type: 'app',
+                    name: label.isEmpty ? pkg : label,
+                    detail: pkg,
+                  ));
+              Navigator.of(context).pop();
+              ScaffoldMessenger.of(context).showSnackBar(
+                const SnackBar(content: Text('已发到对话，直接跟 AI 说你想做什么')),
+              );
+            },
+            child: Row(
+              children: const [
+                Icon(Icons.arrow_outward_rounded, size: 18, color: AppColors.brand),
+                SizedBox(width: 10),
+                Expanded(child: Text('发到对话', style: TextStyle(fontSize: 13))),
+                Icon(Icons.chevron_right_rounded, size: 18, color: Color(0xFFCBD5E1)),
+              ],
+            ),
+          ),
+          const SizedBox(height: 10),
+          const Text(
+            '看 APK、导出、抓包、查内存这些都不在这里放按钮，发到对话让 AI 决定怎么做。',
+            style: TextStyle(fontSize: 10.5, color: AppColors.muted, height: 1.7),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _kv(String k, String v) => Padding(
+        padding: const EdgeInsets.symmetric(vertical: 7),
+        child: Row(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            SizedBox(
+              width: 76,
+              child: Text(k, style: const TextStyle(fontSize: 11, color: AppColors.muted)),
+            ),
+            Expanded(
+              child: Text(v.isEmpty ? '—' : v,
+                  style: const TextStyle(fontSize: 11, fontFamily: 'monospace', height: 1.5)),
+            ),
+          ],
+        ),
+      );
+}
