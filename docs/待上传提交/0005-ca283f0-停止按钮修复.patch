之前点停止无效的三个原因：
1. stop() 不解脱 pendingPermission → 卡在等授权时永远停不下来
2. 点击后没有任何视觉反馈，且 _running 要等 finally 才复位
3. 后台若卡在非 LLM 的 await，按钮会一直转

改法：
- stop() 里 resolve pendingPermission('deny')，解除等待
- 新增 stopping 状态，按钮变红色 spinner（停止中）
- 3 秒兜底：仍未退出就强制复位 running 并插入「已强制停止」
- 版本 6.2.5+625（仅本地提交）
---
 lib/agent/agent_engine.dart | 22 +++++++++++++++++++++-
 lib/pages/chat_page.dart    | 11 ++++++++++-
 pubspec.yaml                |  2 +-
 3 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/lib/agent/agent_engine.dart b/lib/agent/agent_engine.dart
index bdf71f1..96476d5 100644
--- a/lib/agent/agent_engine.dart
+++ b/lib/agent/agent_engine.dart
@@ -67,13 +67,22 @@ class AgentEngine extends ChangeNotifier {
 
   bool _running = false;
   bool _stopRequested = false;
+  bool _stopping = false;
 
   /// 当前是否正在生成（UI 用它把发送键换成停止键）。
   bool get running => _running;
 
+  /// 已点了停止，正在等后台退出（UI 用它显示「停止中」）。
+  bool get stopping => _stopping;
+
   void stop() {
-    if (!_running) return;
+    if (!_running && pendingPermission == null) return;
     _stopRequested = true;
+    _stopping = true;
+    // 关键：卡在等授权时，不解除就永远停不下来
+    final p = pendingPermission;
+    pendingPermission = null;
+    p?.resolve('deny');
     streaming = false;
     streamingText = '';
     _stopTyping();
@@ -93,6 +102,15 @@ class AgentEngine extends ChangeNotifier {
     // 急停：把还在跑的容器命令全部杀掉，不用等它自己结束
     NativeBridge.killAllProcs();
     notifyListeners();
+    // 兜底：3 秒还没退出就强制解锁 UI，不让按钮卡死
+    Future.delayed(const Duration(seconds: 3), () {
+      if (_running) {
+        _running = false;
+        _stopping = false;
+        _add(const ChatMsg('assistant', '（已强制停止）'));
+        notifyListeners();
+      }
+    });
   }
 
   /// 当前等待用户确认的工具调用（UI 监听它显示内联授权卡片）。
@@ -524,11 +542,13 @@ class AgentEngine extends ChangeNotifier {
 
     _running = true;
     _stopRequested = false;
+    _stopping = false;
     notifyListeners();
     try {
       await _runLoop(api, tools);
     } finally {
       _running = false;
+      _stopping = false;
       notifyListeners();
     }
   }
diff --git a/lib/pages/chat_page.dart b/lib/pages/chat_page.dart
index fb20d26..72166da 100644
--- a/lib/pages/chat_page.dart
+++ b/lib/pages/chat_page.dart
@@ -744,7 +744,16 @@ class _ChatPageState extends ConsumerState<ChatPage> {
                         width: 36,
                         height: 36,
                         decoration: const BoxDecoration(color: Color(0xFFEF4444), shape: BoxShape.circle),
-                        child: const Icon(Icons.stop_rounded, size: 20, color: Colors.white),
+                        child: engine.stopping
+                            ? const Center(
+                                child: SizedBox(
+                                  width: 15,
+                                  height: 15,
+                                  child: CircularProgressIndicator(
+                                      strokeWidth: 2, valueColor: AlwaysStoppedAnimation(Colors.white)),
+                                ),
+                              )
+                            : const Icon(Icons.stop_rounded, size: 20, color: Colors.white),
                       ),
                     )
                   : ScaleOnTap(
