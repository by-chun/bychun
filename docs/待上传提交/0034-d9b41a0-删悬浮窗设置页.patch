-// ---------------- 悬浮窗设置 ----------------
-class OvsetPage extends StatefulWidget {
-  final bool embedded;
-  const OvsetPage({super.key, this.embedded = false});
-  @override
-  State<OvsetPage> createState() => _OvsetPageState();
-}
-
-class _OvsetPageState extends State<OvsetPage> {
-  double _size = 48;
-  double _opacity = 80;
-  double _panelOpacity = 92;
-  bool _draggable = true;
-
-  Future<void> _pick(String fileName) async {
-    final x = await ImagePicker().pickImage(source: ImageSource.gallery);
-    if (x == null) return;
-    final dir = await NativeBridge.appDataDir();
-    if (dir.isEmpty) return;
-    await File(x.path).copy('$dir/$fileName');
-    await NativeBridge.setOverlayPref(size: _size.round(), opacity: _opacity / 100);
-    if (mounted) {
-      showToast(context, '已保存，重新打开悬浮窗生效', error: false);
-    }
-  }
-
-  Widget _rw(String label, String value, {String? action, VoidCallback? onTap, Widget? trailing}) {
-    return Padding(
-      padding: const EdgeInsets.symmetric(vertical: 9),
-      child: Row(children: [
-        Text(label, style: const TextStyle(fontSize: 13, color: AppColors.text)),
-        const Spacer(),
-        if (value.isNotEmpty) Text(value, style: const TextStyle(fontSize: 12, color: AppColors.muted)),
-        if (action != null) ...[
-          const SizedBox(width: 12),
-          GestureDetector(onTap: onTap, child: Text(action, style: const TextStyle(fontSize: 11.5, color: AppColors.brand, fontWeight: FontWeight.w600))),
-        ],
-        if (trailing != null) trailing,
-      ]),
-    );
-  }
-
-  @override
-  Widget build(BuildContext context) {
-    final body = ListView(
-        padding: const EdgeInsets.all(16),
-        children: [
-          const Text('悬浮球', style: TextStyle(fontSize: 11, color: AppColors.muted)),
-          GlassCard(
-            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 4),
-            child: Column(children: [
-              _rw('悬浮球图标', '默认 G 标', action: '更换', onTap: () => _pick('overlay_icon.png')),
-              NumberFieldRow(label: '大小', value: _size, min: 32, max: 80, suffix: 'dp', onChanged: (v) => setState(() => _size = v)),
-              NumberFieldRow(label: '透明度', value: _opacity, min: 20, max: 100, suffix: '%', onChanged: (v) => setState(() => _opacity = v)),
-              _rw('贴边位置', '自动（左/右）'),
-            ]),
-          ),
-          const SizedBox(height: 12),
-          const Text('搜索面板', style: TextStyle(fontSize: 11, color: AppColors.muted)),
-          GlassCard(
-            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 4),
-            child: Column(children: [
-              _rw('面板背景', '纯白', action: '更换', onTap: () => _pick('overlay_bg.png')),
-              NumberFieldRow(label: '面板透明度', value: _panelOpacity, min: 40, max: 100, suffix: '%', onChanged: (v) => setState(() => _panelOpacity = v)),
-              _rw('可拖动 / 缩放 / 最小化', '', trailing: Switch(value: _draggable, activeThumbColor: AppColors.brand, onChanged: (v) => setState(() => _draggable = v))),
-            ]),
-          ),
-          const Padding(
-            padding: EdgeInsets.only(top: 10),
-            child: Text('悬浮窗支持拖动、按钮/双指缩放、最小化到悬浮球', style: TextStyle(fontSize: 10.5, color: AppColors.muted)),
-          ),
-        ],
-      );
-    if (widget.embedded) {
-      return embedShell(title: '悬浮窗设置', body: body);
-    }
-    return Scaffold(
-      backgroundColor: Colors.white,
-      appBar: AppBar(
-        leading: const BackButton(),
-        backgroundColor: Colors.white,
-        elevation: 0,
-        title: const Text('悬浮窗设置', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w800)),
-      ),
-      body: body,
-    );
-  }
-}
