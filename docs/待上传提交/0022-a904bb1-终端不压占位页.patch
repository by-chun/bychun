点终端/快捷入口时直接调 NativeBridge.openTerminal() 开原生窗口，
不再 push TerminalPage（那个只显示「终端已在新窗口打开」的空壳），
从原生终端返回后直接回到对话页。

版本 6.6.4+664（仅本地提交）
---
 lib/pages/chat_page.dart | 10 ++++++----
 pubspec.yaml             |  2 +-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/lib/pages/chat_page.dart b/lib/pages/chat_page.dart
index cae7766..b4fb452 100644
--- a/lib/pages/chat_page.dart
+++ b/lib/pages/chat_page.dart
@@ -22,7 +22,6 @@ import 'chat_message.dart';
 import '../widgets/view_cards.dart';
 import 'permission_panel.dart';
 import 'compact_page.dart';
-import 'terminal_page.dart';
 import 'reverse_page.dart';
 import 'files_page.dart';
 import 'memory_page.dart';
@@ -450,8 +449,8 @@ class _ChatPageState extends ConsumerState<ChatPage> {
   }
 
   void _openTerminal(BuildContext context) {
-    // 统一走原生 Termux TerminalView（TerminalActivity）：多标签、环境切换、root 标签、PTY 都在那边
-    Navigator.of(context).push(MaterialPageRoute(builder: (_) => const TerminalPage()));
+    // 直接开原生终端窗口，不在 Flutter 侧压占位页
+    NativeBridge.openTerminal();
   }
 
   Widget _quickBar(BuildContext context) {
@@ -535,8 +534,11 @@ class _ChatPageState extends ConsumerState<ChatPage> {
 
   Future<void> _runQuick(QuickAction q) async {
     if (q.type == 'open') {
+      if (q.arg == 'terminal') {
+        NativeBridge.openTerminal();
+        return;
+      }
       final page = switch (q.arg) {
-        'terminal' => const TerminalPage(),
         'memory' => const MemoryPage(),
         'reverse' => const ReversePage(),
         'files' => const FilesPage(),
diff --git a/pubspec.yaml b/pubspec.yaml
index 079d6c4..43f5246 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: 'none' # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
 # In Windows, build-name is used as the major, minor, and patch parts
 # of the product and file versions while build-number is used as the build suffix.
-version: 6.6.3+663
+version: 6.6.4+664
 
 environment:
   sdk: ^3.9.2
