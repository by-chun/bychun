- ViewCard 新增 onAction：表单提交后把内容作为用户消息发回 AI
- _FormViewCard 改为 StatefulWidget：字段可编辑，底部「提交」按钮
- 提交内容格式：「submit 文本」+ 逐行「标签: 值」
- chat_page 注入 onAction（AI 忙时提示稍后再提交）
- 版本 6.6.2+662（仅本地提交）
---
 lib/pages/chat_page.dart    |  8 ++++
 lib/widgets/view_cards.dart | 87 ++++++++++++++++++++++++++++++-------
 pubspec.yaml                |  2 +-
 3 files changed, 81 insertions(+), 16 deletions(-)

diff --git a/lib/pages/chat_page.dart b/lib/pages/chat_page.dart
index 5940842..cae7766 100644
--- a/lib/pages/chat_page.dart
+++ b/lib/pages/chat_page.dart
@@ -145,6 +145,14 @@ class _ChatPageState extends ConsumerState<ChatPage> {
           view: v.msg.view ?? '',
           title: v.msg.viewTitle ?? v.msg.toolName ?? '',
           data: v.msg.viewData ?? const {},
+          onAction: (text) {
+            if (engine.running) {
+              ScaffoldMessenger.of(context)
+                  .showSnackBar(const SnackBar(content: Text('AI 还在处理上一条，稍后再提交')));
+              return;
+            }
+            engine.send(text);
+          },
         ),
       _ => const SizedBox.shrink(),
     };
diff --git a/lib/widgets/view_cards.dart b/lib/widgets/view_cards.dart
index 5c0258d..0c32982 100644
--- a/lib/widgets/view_cards.dart
+++ b/lib/widgets/view_cards.dart
@@ -13,7 +13,9 @@ class ViewCard extends StatelessWidget {
   final String view;
   final String title;
   final Map<String, dynamic> data;
-  const ViewCard({super.key, required this.view, required this.title, required this.data});
+  /// 表单提交/按钮点击后，把文本当作一条用户消息发回给 AI。
+  final void Function(String text)? onAction;
+  const ViewCard({super.key, required this.view, required this.title, required this.data, this.onAction});
 
   @override
   Widget build(BuildContext context) {
@@ -25,7 +27,7 @@ class ViewCard extends StatelessWidget {
       case 'stream':
         return _StreamViewCard(title: title, data: data);
       case 'form':
-        return _FormViewCard(title: title, data: data);
+        return _FormViewCard(title: title, data: data, onAction: onAction);
       case 'confirm':
         return _ConfirmViewCard(title: title, data: data);
       default:
@@ -288,16 +290,56 @@ class _StreamViewCardState extends State<_StreamViewCard> {
   }
 }
 
-class _FormViewCard extends StatelessWidget {
+class _FormViewCard extends StatefulWidget {
   final String title;
   final Map<String, dynamic> data;
-  const _FormViewCard({required this.title, required this.data});
+  final void Function(String)? onAction;
+  const _FormViewCard({required this.title, required this.data, this.onAction});
+
+  @override
+  State<_FormViewCard> createState() => _FormViewCardState();
+}
+
+class _FormViewCardState extends State<_FormViewCard> {
+  final Map<String, TextEditingController> _c = {};
+
+  @override
+  void initState() {
+    super.initState();
+    for (final f in (widget.data['fields'] as List?) ?? const []) {
+      final m = f as Map;
+      final k = '${m['key'] ?? ''}';
+      _c[k] = TextEditingController(text: '${m['value'] ?? ''}');
+    }
+  }
+
+  @override
+  void dispose() {
+    for (final c in _c.values) {
+      c.dispose();
+    }
+    super.dispose();
+  }
+
+  void _submit() {
+    final fields = (widget.data['fields'] as List?) ?? const [];
+    final submit = (widget.data['submit'] ?? '提交').toString();
+    final lines = <String>[submit];
+    for (final f in fields) {
+      final m = f as Map;
+      final k = '${m['key'] ?? ''}';
+      final label = '${m['label'] ?? k}';
+      lines.add('$label: ${_c[k]?.text.trim() ?? ''}');
+    }
+    widget.onAction?.call(lines.join('\n'));
+  }
 
   @override
   Widget build(BuildContext context) {
-    final fields = (data['fields'] as List?) ?? const [];
+    final fields = (widget.data['fields'] as List?) ?? const [];
+    final submit = widget.data['submit'];
     return _shell(
-      title: title,
+      title: widget.title,
       child: Padding(
         padding: const EdgeInsets.fromLTRB(12, 10, 12, 12),
         child: Column(
@@ -312,20 +354,35 @@ class _FormViewCard extends StatelessWidget {
                     Text('${(f as Map)['label'] ?? ''}',
                         style: const TextStyle(fontSize: 9.5, color: AppColors.muted)),
                     const SizedBox(height: 3),
-                    Container(
-                      width: double.infinity,
-                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 9),
-                      decoration: BoxDecoration(
-                        color: const Color(0xFFF7F9FC),
-                        borderRadius: BorderRadius.circular(8),
+                    TextField(
+                      controller: _c['${f['key'] ?? ''}'],
+                      style: const TextStyle(fontSize: 10.5, fontFamily: 'monospace', color: AppColors.text),
+                      decoration: InputDecoration(
+                        isDense: true,
+                        filled: true,
+                        fillColor: const Color(0xFFF7F9FC),
+                        contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 9),
+                        border: OutlineInputBorder(
+                          borderRadius: BorderRadius.circular(8),
+                          borderSide: BorderSide.none,
+                        ),
                       ),
-                      child: Text('${f['value'] ?? ''}',
-                          style: const TextStyle(
-                              fontSize: 10.5, fontFamily: 'monospace', color: AppColors.text)),
                     ),
                   ],
                 ),
               ),
+            if (submit != null)
+              Align(
+                alignment: Alignment.centerRight,
+                child: FilledButton(
+                  onPressed: _submit,
+                  style: FilledButton.styleFrom(
+                    backgroundColor: AppColors.brand,
+                    padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 10),
+                  ),
+                  child: Text('${submit}', style: const TextStyle(fontSize: 11.5, fontWeight: FontWeight.w600)),
+                ),
+              ),
           ],
         ),
       ),
