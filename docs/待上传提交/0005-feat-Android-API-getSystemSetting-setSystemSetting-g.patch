+import 'dart:convert';
+
+import '../native/native_bridge.dart';
+import 'tool.dart';
+
+/// 定位 + 蓝牙 + 浏览器 工具（都走原生 Android API，容器替不了）。
+void registerNativeTools(ToolRegistry reg) {
+  reg.register(GetLocationTool());
+  reg.register(BluetoothStateTool());
+  reg.register(BluetoothScanTool());
+  reg.register(BluetoothConnectTool());
+  reg.register(BluetoothReadTool());
+  reg.register(BluetoothWriteTool());
+  reg.register(BluetoothSubscribeTool());
+  reg.register(BrowserOpenTool());
+  reg.register(BrowserExecJsTool());
+  reg.register(BrowserSnapshotTool());
+}
+
+/// 定位：读最后已知位置。
+class GetLocationTool extends AgentTool {
+  @override
+  String get name => 'getLocation';
+
+  @override
+  String get description => '读当前设备大致位置（最后已知的 GPS/网络定位）。首次需授权定位权限；拿不到说明定位服务没开。';
+
+  @override
+  Map<String, String> get parameters => {};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final r = await NativeBridge.getLocation();
+    if (r['ok'] != true) return ToolResult(false, (r['error'] ?? '定位失败').toString());
+    return ToolResult(
+      true,
+      '纬度 ${r['lat']}，经度 ${r['lng']}，精度 ±${(r['accuracy'] as num?)?.toStringAsFixed(0) ?? '?'}m（${r['provider']}）',
+    );
+  }
+}
+
+/// 蓝牙状态。
+class BluetoothStateTool extends AgentTool {
+  @override
+  String get name => 'bluetoothState';
+
+  @override
+  String get description => '查蓝牙开关状态与设备名。';
+
+  @override
+  Map<String, String> get parameters => {};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final r = await NativeBridge.bluetoothState();
+    if (r['ok'] != true) return ToolResult(false, (r['error'] ?? '蓝牙不可用').toString());
+    return ToolResult(true, '蓝牙${r['enabled'] == true ? '已开' : '已关'}，设备名 ${r['name']}');
+  }
+}
+
+/// 扫描 BLE 设备。
+class BluetoothScanTool extends AgentTool {
+  @override
+  String get name => 'bluetoothScan';
+
+  @override
+  String get description => '扫描附近蓝牙/BLE 设备，返回名称、地址、信号强度。Android 12+ 需蓝牙权限。';
+
+  @override
+  Map<String, String> get parameters => {'seconds': '扫描时长（秒），默认 5'};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final sec = int.tryParse(args['seconds'] ?? '') ?? 5;
+    final r = await NativeBridge.bluetoothScan(sec);
+    if (r['ok'] != true) return ToolResult(false, (r['error'] ?? '扫描失败').toString());
+    final devs = (r['devices'] as List?) ?? const [];
+    if (devs.isEmpty) return const ToolResult(true, '没扫到设备');
+    return ToolResult(
+      true,
+      '扫到 ${devs.length} 个设备',
+      view: 'list',
+      title: '蓝牙设备',
+      viewData: {
+        'items': [
+          for (final d in devs)
+            {'title': d['name'], 'subtitle': d['address'], 'badge': '${d['rssi']} dBm'}
+        ],
+      },
+    );
+  }
+}
+
+/// 连接 BLE 设备。
+class BluetoothConnectTool extends AgentTool {
+  @override
+  String get name => 'bluetoothConnect';
+
+  @override
+  String get description => '连接一个蓝牙 BLE 设备（用 bluetoothScan 拿到的 address），返回服务/特征 UUID 列表。';
+
+  @override
+  Map<String, String> get parameters => {'address': '设备 MAC 地址'};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final addr = (args['address'] ?? '').trim();
+    if (addr.isEmpty) return const ToolResult(false, 'address 不能为空');
+    final r = await NativeBridge.bluetoothConnect(addr);
+    if (r['ok'] != true) return ToolResult(false, (r['error'] ?? '连接失败').toString());
+    final svcs = (r['services'] as List?) ?? const [];
+    final buf = StringBuffer();
+    for (final s in svcs) {
+      buf.writeln('服务 ${s['uuid']}');
+      for (final c in (s['chars'] as List? ?? const [])) {
+        buf.writeln('  特征 $c');
+      }
+    }
+    return ToolResult(true, '已连接，服务列表：\n$buf');
+  }
+}
+
+/// 读特征。
+class BluetoothReadTool extends AgentTool {
+  @override
+  String get name => 'bluetoothRead';
+
+  @override
+  String get description => '读一个蓝牙特征值。service 可留空。返回 base64 与可读文本。';
+
+  @override
+  Map<String, String> get parameters => {
+        'address': '设备 MAC',
+        'service': '服务 UUID（可留空）',
+        'char': '特征 UUID',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final addr = (args['address'] ?? '').trim();
+    final svc = (args['service'] ?? '').trim();
+    final ch = (args['char'] ?? '').trim();
+    if (addr.isEmpty || ch.isEmpty) return const ToolResult(false, 'address 和 char 不能为空');
+    final r = await NativeBridge.bluetoothRead(addr, svc.isEmpty ? null : svc, ch);
+    if (r['ok'] != true) return ToolResult(false, (r['error'] ?? '读取失败').toString());
+    return ToolResult(true, 'base64: ${r['base64']}\n文本: ${r['text']}');
+  }
+}
+
+/// 写特征。
+class BluetoothWriteTool extends AgentTool {
+  @override
+  String get name => 'bluetoothWrite';
+
+  @override
+  String get description => '写一个蓝牙特征值。data 为要写入的内容（UTF-8 编码）。';
+
+  @override
+  Map<String, String> get parameters => {
+        'address': '设备 MAC',
+        'service': '服务 UUID（可留空）',
+        'char': '特征 UUID',
+        'data': '要写入的文本',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final addr = (args['address'] ?? '').trim();
+    final svc = (args['service'] ?? '').trim();
+    final ch = (args['char'] ?? '').trim();
+    final data = args['data'] ?? '';
+    if (addr.isEmpty || ch.isEmpty) return const ToolResult(false, 'address 和 char 不能为空');
+    final b64 = base64Encode(utf8.encode(data));
+    final r = await NativeBridge.bluetoothWrite(addr, svc.isEmpty ? null : svc, ch, b64);
+    if (r['ok'] != true) return ToolResult(false, (r['error'] ?? '写入失败').toString());
+    return ToolResult(true, '已写入 ${r['written']} 字节');
+  }
+}
+
+/// 订阅通知。
+class BluetoothSubscribeTool extends AgentTool {
+  @override
+  String get name => 'bluetoothSubscribe';
+
+  @override
+  String get description => '订阅一个蓝牙特征的通知，监听几秒后返回收到的数据。';
+
+  @override
+  Map<String, String> get parameters => {
+        'address': '设备 MAC',
+        'service': '服务 UUID（可留空）',
+        'char': '特征 UUID',
+        'seconds': '监听时长（秒），默认 5',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final addr = (args['address'] ?? '').trim();
+    final svc = (args['service'] ?? '').trim();
+    final ch = (args['char'] ?? '').trim();
+    final sec = int.tryParse(args['seconds'] ?? '') ?? 5;
+    if (addr.isEmpty || ch.isEmpty) return const ToolResult(false, 'address 和 char 不能为空');
+    final r = await NativeBridge.bluetoothSubscribe(addr, svc.isEmpty ? null : svc, ch, sec);
+    if (r['ok'] != true) return ToolResult(false, (r['error'] ?? '订阅失败').toString());
+    final notes = (r['notifications'] as List?) ?? const [];
+    return ToolResult(true, notes.isEmpty ? '监听到 ${sec}s，没有收到通知' : '收到 ${notes.length} 条通知：\n${notes.join('\n')}');
+  }
+}
+
+/// 打开内置浏览器。
+class BrowserOpenTool extends AgentTool {
+  @override
+  String get name => 'browserOpen';
+
+  @override
+  String get description => '打开内置浏览器访问一个网址。之后可用 browserSnapshot 读页面文本、browserExecJs 执行脚本、用 screenTap 点击。';
+
+  @override
+  Map<String, String> get parameters => {'url': '网址'};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final url = (args['url'] ?? '').trim();
+    if (url.isEmpty) return const ToolResult(false, 'url 不能为空');
+    final ok = await NativeBridge.browserOpen(url);
+    return ToolResult(ok, ok ? '已打开 $url（可用 browserSnapshot 读内容）' : '打开失败');
+  }
+}
+
+/// 执行 JS。
+class BrowserExecJsTool extends AgentTool {
+  @override
+  String get name => 'browserExecJs';
+
+  @override
+  String get description => '在内置浏览器的当前页面执行一段 JavaScript，返回结果（字符串）。可用于读数据、填表、点击等。';
+
+  @override
+  Map<String, String> get parameters => {'js': 'JavaScript 代码'};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final js = args['js'] ?? '';
+    if (js.isEmpty) return const ToolResult(false, 'js 不能为空');
+    final r = await NativeBridge.browserExecJs(js);
+    return ToolResult(true, r.isEmpty ? '（无返回值）' : r);
+  }
+}
+
+/// 页面快照。
+class BrowserSnapshotTool extends AgentTool {
+  @override
+  String get name => 'browserSnapshot';
+
+  @override
+  String get description => '读内置浏览器当前页面的纯文本内容（body.innerText），用于理解页面。';
+
+  @override
+  Map<String, String> get parameters => {'max': '最大字符数，默认 4000'};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final max = int.tryParse(args['max'] ?? '') ?? 4000;
+    final r = await NativeBridge.browserSnapshot(max: max);
+    return ToolResult(true, r.isEmpty ? '（页面为空或浏览器没打开）' : r);
+  }
+}
diff --git a/lib/agent/tools_system.dart b/lib/agent/tools_system.dart
new file mode 100644
index 0000000..ae14c28
--- /dev/null
+++ b/lib/agent/tools_system.dart
@@ -0,0 +1,197 @@
+import 'dart:convert';
+
+import '../native/native_bridge.dart';
+import 'tool.dart';
+
+/// 系统设置 / 通知 / 应用使用时长 —— 走 root shell 命令（settings / dumpsys），
+/// 这些 Android API 没有对应的「无 root 可写」通道，root 下命令最稳。
+void registerSystemTools(ToolRegistry reg) {
+  reg.register(GetSystemSettingTool());
+  reg.register(SetSystemSettingTool());
+  reg.register(GetNotificationsTool());
+  reg.register(GetAppUsageTool());
+}
+
+/// 读系统设置：settings get <namespace> <key>。
+/// namespace: system / global / secure（secure 需要 root）。
+class GetSystemSettingTool extends AgentTool {
+  @override
+  String get name => 'getSystemSetting';
+
+  @override
+  String get description =>
+      '读一项 Android 系统设置。namespace 用 system（一般项）/ global（全局）/ secure（安全项，需 root）。'
+      '常用：screen_brightness、screen_off_timeout、volume_music_speaker（system）；airplane_mode_on（global）。';
+
+  @override
+  Map<String, String> get parameters => {
+        'namespace': 'system / global / secure',
+        'key': '设置键名',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final ns = (args['namespace'] ?? 'system').trim();
+    final key = (args['key'] ?? '').trim();
+    if (key.isEmpty) return const ToolResult(false, 'key 不能为空');
+    if (!['system', 'global', 'secure'].contains(ns)) {
+      return const ToolResult(false, 'namespace 只能是 system/global/secure');
+    }
+    final r = await NativeBridge.rootExec('settings get $ns $key');
+    final v = (r.stdout + r.stderr).trim();
+    if (v.isEmpty || v == 'null') return ToolResult(true, '未设置（空）');
+    return ToolResult(true, '$ns.$key = $v');
+  }
+}
+
+/// 写系统设置：settings put <namespace> <key> <value>。
+class SetSystemSettingTool extends AgentTool {
+  @override
+  String get name => 'setSystemSetting';
+
+  @override
+  String get description =>
+      '写一项 Android 系统设置（需 root）。namespace 用 system / global / secure。'
+      '会先确认值合法；写失败会带回 stderr。改音量/亮度/屏幕超时/飞行模式等都用这个。';
+
+  @override
+  Map<String, String> get parameters => {
+        'namespace': 'system / global / secure',
+        'key': '设置键名',
+        'value': '要写入的值（数字或字符串）',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final ns = (args['namespace'] ?? 'system').trim();
+    final key = (args['key'] ?? '').trim();
+    final value = (args['value'] ?? '').trim();
+    if (key.isEmpty || value.isEmpty) return const ToolResult(false, 'key 和 value 不能为空');
+    if (!['system', 'global', 'secure'].contains(ns)) {
+      return const ToolResult(false, 'namespace 只能是 system/global/secure');
+    }
+    final r = await NativeBridge.rootExec('settings put $ns $key "$value"');
+    if (r.code != 0) return ToolResult(false, '写入失败：${r.stderr.trim()}');
+    return ToolResult(true, '已设置 $ns.$key = $value');
+  }
+}
+
+/// 读通知：dumpsys notification --noredact（root 下能拿到不脱敏的文本）。
+class GetNotificationsTool extends AgentTool {
+  @override
+  String get name => 'getNotifications';
+
+  @override
+  String get description =>
+      '读取当前通知栏里的通知（标题、正文、来源应用）。需 root，用 dumpsys notification 解析。'
+      '返回可见的活跃通知列表；读不到就是没有通知或需要通知读取权限。';
+
+  @override
+  Map<String, String> get parameters => {'limit': '最多返回几条，默认 20'};
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final limit = int.tryParse(args['limit'] ?? '') ?? 20;
+    final r = await NativeBridge.rootExec('dumpsys notification --noredact');
+    final text = r.stdout.isNotEmpty ? r.stdout : r.stderr;
+    if (text.trim().isEmpty) return const ToolResult(false, '读不到通知（可能无通知或 root 不可用）');
+
+    // 解析：NotificationRecord 0x... pkg=xxx user=xxx 之后跟标题/正文行
+    final out = <Map<String, String>>[];
+    final lines = text.split('\n');
+    var cur = <String, String>{};
+    for (final line in lines) {
+      final m = RegExp(r'pkg=(\S+)\s+user=').firstMatch(line);
+      if (m != null) {
+        if (cur.isNotEmpty && out.length < limit) out.add(cur);
+        cur = {'pkg': m.group(1)!};
+      } else if (cur.containsKey('pkg')) {
+        final t = line.trim();
+        if (t.isNotEmpty && !t.startsWith('NotificationRecord') && !t.contains('=')) {
+          if (cur['title'] == null && !t.startsWith('android.')) cur['title'] = t;
+          else if (cur['body'] == null && cur['title'] != null) cur['body'] = t;
+        }
+      }
+      if (out.length >= limit) break;
+    }
+    if (cur.isNotEmpty && out.length < limit) out.add(cur);
+    if (out.isEmpty) return const ToolResult(true, '当前没有活跃通知');
+
+    return ToolResult(
+      true,
+      '共 ${out.length} 条通知',
+      view: 'list',
+      title: '通知栏',
+      viewData: {
+        'items': [
+          for (final n in out)
+            {
+              'title': (n['title'] ?? '').toString(),
+              'subtitle': (n['body'] ?? '').toString(),
+              'badge': (n['pkg'] ?? '').toString(),
+            }
+        ],
+      },
+    );
+  }
+}
+
+/// 应用使用时长：dumpsys usagestats。
+class GetAppUsageTool extends AgentTool {
+  @override
+  String get name => 'getAppUsage';
+
+  @override
+  String get description =>
+      '查应用使用时长/次数（最近一段时间）。需 root 或已授权「使用情况访问权限」。'
+      'package 可留空看全部，或给包名看单个。';
+
+  @override
+  Map<String, String> get parameters => {
+        'package': '包名（可留空）',
+        'days': '看最近几天，默认 1',
+      };
+
+  @override
+  Future<ToolResult> execute(Map<String, String> args) async {
+    final pkg = (args['package'] ?? '').trim();
+    final r = await NativeBridge.rootExec('dumpsys usagestats');
+    final text = r.stdout.isNotEmpty ? r.stdout : r.stderr;
+    if (text.trim().isEmpty) return const ToolResult(false, '读不到使用统计（需 root 或使用情况访问权限）');
+
+    // 解析包名 + 时长块。每个包一段 "Package: com.xxx"，下面有 "totalTimeUsed=..." 
+    final out = <Map<String, String>>[];
+    final blocks = text.split(RegExp(r'Package:\s+'));
+    for (final b in blocks.skip(1)) {
+      final name = b.split('\n').first.trim();
+      if (pkg.isNotEmpty && name != pkg) continue;
+      final tt = RegExp(r'totalTimeUsed=([0-9]+)').firstMatch(b);
+      final tc = RegExp(r'timesUsed=([0-9]+)').firstMatch(b);
+      final secs = int.tryParse(tt?.group(1) ?? '') ?? 0;
+      final cnt = int.tryParse(tc?.group(1) ?? '') ?? 0;
+      if (secs == 0 && cnt == 0) continue;
+      out.add({
+        'pkg': name,
+        'time': secs >= 3600
+            ? '${(secs / 3600).toStringAsFixed(1)}h'
+            : '${(secs / 60).toStringAsFixed(0)}m',
+        'count': '$cnt 次',
+      });
+      if (out.length >= 30) break;
+    }
+    if (out.isEmpty) return const ToolResult(true, '没有找到${pkg.isEmpty ? '' : ' $pkg '}的使用记录');
+
+    return ToolResult(
+      true,
+      '共 ${out.length} 个应用',
+      view: 'list',
+      title: '应用使用时长',
+      viewData: {
+        'items': [
+          for (final a in out)
+            {'title': a['pkg'], 'subtitle': '${a['time']} · ${a['count']}', 'badge': a['time']}
+        ],
+      },
+    );
+  }
+}
