+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../theme/app_theme.dart';
+import '../theme/glass.dart';
+import '../theme/glass_dialog.dart';
+import '../native/native_bridge.dart';
+import '../state/chat_refs.dart';
+
+/// 插件 = 目录里的任意文件。不规定格式，按扩展名决定能做什么。
+class PluginsPage extends StatefulWidget {
+  const PluginsPage({super.key});
+  @override
+  State<PluginsPage> createState() => _PluginsPageState();
+}
+
+class _PluginsPageState extends State<PluginsPage> {
+  static const root = '/storage/emulated/0/G/plugins';
+  String _path = root;
+  List<(String, bool)> _items = [];
+  bool _loading = true;
+
+  @override
+  void initState() {
+    super.initState();
+    _load(_path);
+  }
+
+  Future<void> _load(String path) async {
+    await NativeBridge.requestStorage();
+    setState(() {
+      _loading = true;
+      _path = path;
+    });
+    await NativeBridge.exec("mkdir -p '$root'");
+    final r = await NativeBridge.exec("ls -1ap '${path.replaceAll("'", "'\\''")}'");
+    final items = <(String, bool)>[];
+    if (r.ok) {
+      for (final line in r.stdout.split('\n')) {
+        final t = line.trim();
+        if (t.isEmpty || t == './' || t == '../') continue;
+        items.add((t.endsWith('/') ? t.substring(0, t.length - 1) : t, t.endsWith('/')));
+      }
+    }
+    // 文件夹在前
+    items.sort((a, b) {
+      if (a.$2 != b.$2) return a.$2 ? -1 : 1;
+      return a.$1.toLowerCase().compareTo(b.$1.toLowerCase());
+    });
+    if (mounted) {
+      setState(() {
+        _items = items;
+        _loading = false;
+      });
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final isRoot = _path == root;
+    return Scaffold(
+      backgroundColor: Colors.white,
+      appBar: AppBar(
+        leading: isRoot
+            ? const BackButton()
+            : IconButton(
+                icon: const Icon(Icons.arrow_back_rounded),
+                onPressed: () {
+                  final p = _path.substring(0, _path.lastIndexOf('/'));
+                  _load(p.isEmpty ? root : p);
+                },
+              ),
+        backgroundColor: Colors.white,
+        elevation: 0,
+        title: Text(isRoot ? '插件' : _path.split('/').last,
+            style: const TextStyle(fontSize: 17, fontWeight: FontWeight.w800)),
+        actions: [
+          IconButton(
+            tooltip: '新建文件夹',
+            onPressed: _newFolder,
+            icon: const Icon(Icons.create_new_folder_outlined, size: 20, color: Color(0xFF94A3B8)),
+          ),
+          IconButton(
+            onPressed: () => _load(_path),
+            icon: const Icon(Icons.refresh_rounded, size: 20, color: Color(0xFF94A3B8)),
+          ),
+        ],
+      ),
+      body: _loading
+          ? const Center(child: CircularProgressIndicator())
+          : ListView(
+              padding: const EdgeInsets.fromLTRB(16, 4, 16, 20),
+              children: [
+                Text(_path,
+                    style: const TextStyle(fontSize: 9.5, color: AppColors.muted, fontFamily: 'monospace')),
+                const SizedBox(height: 8),
+                if (isRoot) _seedCard(),
+                if (_items.isEmpty && isRoot)
+                  const Padding(
+                    padding: EdgeInsets.only(top: 20),
+                    child: Text('空目录：把 .sh / .py / .js / .json 随便丢进来就行',
+                        style: TextStyle(fontSize: 11, color: AppColors.muted)),
+                  ),
+                for (final e in _items) _tile(e.$1, e.$2),
+              ],
+            ),
+    );
+  }
+
+  Widget _seedCard() => GlassCard(
+        margin: const EdgeInsets.only(bottom: 8),
+        onTap: _installSeed,
+        child: Row(
+          children: const [
+            Icon(Icons.inventory_2_outlined, size: 18, color: AppColors.brand),
+            SizedBox(width: 10),
+            Expanded(child: Text('安装内置插件', style: TextStyle(fontSize: 12.5))),
+            Icon(Icons.chevron_right_rounded, size: 18, color: Color(0xFFCBD5E1)),
+          ],
+        ),
+      );
+
+  Future<void> _installSeed() async {
+    final ok = await showGlassDialog<bool>(
+      context: context,
+      title: '安装内置插件',
+      content: const Text(
+        '会往插件目录写入一批示例文件（抓包模板、重写规则等），之后可随意改或删。',
+        style: TextStyle(fontSize: 12.5, height: 1.6),
+      ),
+      confirmText: '安装',
+    );
+    if (ok != true) return;
+    final r = await NativeBridge.exec(
+      "cd '$root' && printf '%s\\n' "
+      "'{\"method\":\"POST\",\"url\":\"https://example.com/api\",\"headers\":{\"Content-Type\":\"application/json\"}}' "
+      "> '请求模板.json' && printf '%s\\n' '#!/bin/sh' 'echo hello from plugin' > '示例.sh' && chmod 755 '示例.sh'",
+    );
+    if (!mounted) return;
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(content: Text(r.ok ? '已安装：请求模板.json、示例.sh' : '安装失败：${r.stderr}')),
+    );
+    _load(_path);
+  }
+
+  Future<void> _newFolder() async {
+    final c = TextEditingController();
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: Colors.white,
+        title: const Text('新建文件夹', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+        content: TextField(controller: c, autofocus: true),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+          FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('创建')),
+        ],
+      ),
+    );
+    final name = c.text.trim();
+    c.dispose();
+    if (ok != true || name.isEmpty) return;
+    await NativeBridge.exec("mkdir -p '$_path/${name.replaceAll("'", "'\\''")}'");
+    _load(_path);
+  }
+
+  static String _ext(String n) {
+    final i = n.lastIndexOf('.');
+    return i < 0 ? '' : n.substring(i + 1).toLowerCase();
+  }
+
+  static (String, Color, Color) _style(String ext) {
+    switch (ext) {
+      case 'sh':
+        return ('sh', const Color(0xFFECFDF5), const Color(0xFF16A34A));
+      case 'py':
+        return ('py', const Color(0xFFEEF2FF), const Color(0xFF4F46E5));
+      case 'js':
+        return ('js', const Color(0xFFFEF9C3), const Color(0xFFCA8A04));
+      case 'lua':
+        return ('lua', const Color(0xFFF0F9FF), const Color(0xFF0284C7));
+      case 'json':
+        return ('{}', const Color(0xFFEFF6FF), const Color(0xFF2563EB));
+      case 'yaml':
+      case 'yml':
+        return ('yml', const Color(0xFFFDF2F8), const Color(0xFFDB2777));
+      case 'txt':
+      case 'md':
+        return ('txt', const Color(0xFFF1F5F9), const Color(0xFF64748B));
+      default:
+        return (ext.isEmpty ? '?' : ext, const Color(0xFFF1F5F9), const Color(0xFF94A3B8));
+    }
+  }
+
+  Widget _tile(String name, bool isDir) {
+    final full = '$_path/$name';
+    final st = _style(isDir ? '' : _ext(name));
+    return GlassCard(
+      margin: const EdgeInsets.only(bottom: 7),
+      onTap: () => isDir
+          ? _load(full)
+          : Navigator.of(context).push(MaterialPageRoute(builder: (_) => PluginViewPage(path: full, name: name))),
+      onLongPress: () => _menu(name, isDir),
+      child: Row(
+        children: [
+          Container(
+            width: 30,
+            height: 30,
+            decoration: BoxDecoration(color: isDir ? const Color(0xFFEFF6FF) : st.$2, borderRadius: BorderRadius.circular(8)),
+            child: Center(
+              child: isDir
+                  ? const Icon(Icons.folder_rounded, size: 16, color: AppColors.brand)
+                  : Text(st.$1, style: TextStyle(fontSize: 9, fontWeight: FontWeight.w700, color: st.$3)),
+            ),
+          ),
+          const SizedBox(width: 10),
+          Expanded(
+            child: Text(name,
+                maxLines: 1,
+                overflow: TextOverflow.ellipsis,
+                style: TextStyle(
+                    fontSize: 12.5,
+                    fontFamily: isDir ? null : 'monospace',
+                    fontWeight: FontWeight.w500)),
+          ),
+          const Icon(Icons.chevron_right_rounded, size: 18, color: Color(0xFFCBD5E1)),
+        ],
+      ),
+    );
+  }
+
+  Future<void> _menu(String name, bool isDir) async {
+    final act = await showModalBottomSheet<String>(
+      context: context,
+      backgroundColor: Colors.white,
+      shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(18))),
+      builder: (ctx) => SafeArea(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            ListTile(
+              leading: const Icon(Icons.drive_file_rename_outline_rounded),
+              title: const Text('重命名', style: TextStyle(fontSize: 13.5)),
+              onTap: () => Navigator.pop(ctx, 'rename'),
+            ),
+            ListTile(
+              leading: const Icon(Icons.delete_outline_rounded, color: Color(0xFFDC2626)),
+              title: const Text('删除', style: TextStyle(fontSize: 13.5, color: Color(0xFFDC2626))),
+              onTap: () => Navigator.pop(ctx, 'delete'),
+            ),
+          ],
+        ),
+      ),
+    );
+    if (act == 'delete') {
+      final ok = await showGlassDialog<bool>(
+        context: context,
+        title: '删除 $name',
+        content: Text(isDir ? '会连同里面的文件一起删除。' : '文件将被删除。',
+            style: const TextStyle(fontSize: 12.5, height: 1.6)),
+        confirmText: '删除',
+      );
+      if (ok != true) return;
+      await NativeBridge.exec("rm -rf '${_path}/${name.replaceAll("'", "'\\''")}'");
+      _load(_path);
+    } else if (act == 'rename') {
+      final c = TextEditingController(text: name);
+      final ok = await showDialog<bool>(
+        context: context,
+        builder: (ctx) => AlertDialog(
+          backgroundColor: Colors.white,
+          title: const Text('重命名', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+          content: TextField(controller: c, autofocus: true),
+          actions: [
+            TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+            FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('确定')),
+          ],
+        ),
+      );
+      final newName = c.text.trim();
+      c.dispose();
+      if (ok != true || newName.isEmpty || newName == name) return;
+      await NativeBridge.exec(
+          "mv '${_path}/${name.replaceAll("'", "'\\''")}' '${_path}/${newName.replaceAll("'", "'\\''")}'");
+      _load(_path);
+    }
+  }
+}
+
+/// 文件详情：按扩展名决定能做什么。
+class PluginViewPage extends ConsumerStatefulWidget {
+  final String path;
+  final String name;
+  const PluginViewPage({super.key, required this.path, required this.name});
+  @override
+  ConsumerState<PluginViewPage> createState() => _PluginViewPageState();
+}
+
+class _PluginViewPageState extends ConsumerState<PluginViewPage> {
+  String? _content;
+  bool _loading = true;
+
+  String get _ext {
+    final n = widget.name;
+    final i = n.lastIndexOf('.');
+    return i < 0 ? '' : n.substring(i + 1).toLowerCase();
+  }
+
+  bool get _runnable => const ['sh', 'bash'].contains(_ext);
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  Future<void> _load() async {
+    final r = await NativeBridge.exec("head -c 200000 '${widget.path.replaceAll("'", "'\\''")}'");
+    if (mounted) {
+      setState(() {
+        _content = r.ok ? r.stdout : (r.stderr.isEmpty ? '（无法读取）' : r.stderr);
+        _loading = false;
+      });
+    }
+  }
+
+  Future<void> _run() async {
+    final ok = await showGlassDialog<bool>(
+      context: context,
+      title: '运行 ${widget.name}',
+      content: Text('执行：sh ${widget.path}', style: const TextStyle(fontSize: 12, fontFamily: 'monospace')),
+      confirmText: '运行',
+    );
+    if (ok != true) return;
+    final r = await NativeBridge.exec("sh '${widget.path.replaceAll("'", "'\\''")}'", timeout: 60);
+    if (!mounted) return;
+    showDialog<void>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: Colors.white,
+        title: Text('exit ${r.code}', style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w700)),
+        content: SingleChildScrollView(
+          child: Text(
+            '${r.stdout}${r.stderr}'.trim().isEmpty ? '（无输出）' : '${r.stdout}${r.stderr}'.trim(),
+            style: const TextStyle(fontSize: 11, fontFamily: 'monospace', height: 1.5),
+          ),
+        ),
+        actions: [TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('关闭'))],
+      ),
+    );
+  }
+
+  Future<void> _edit() async {
+    final c = TextEditingController(text: _content ?? '');
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: Colors.white,
+        title: const Text('编辑', style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700)),
+        content: SizedBox(
+          width: double.maxFinite,
+          height: 320,
+          child: TextField(
+            controller: c,
+            maxLines: null,
+            expands: true,
+            style: const TextStyle(fontSize: 11.5, fontFamily: 'monospace', height: 1.5),
+          ),
+        ),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('取消')),
+          FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('保存')),
+        ],
+      ),
+    );
+    if (ok != true) return;
+    final p = widget.path.replaceAll("'", "'\\''");
+    await NativeBridge.exec("cat > '$p' << 'GEOF'\n${c.text}\nGEOF");
+    c.dispose();
+    _load();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      backgroundColor: Colors.white,
+      appBar: AppBar(
+        leading: const BackButton(),
+        backgroundColor: Colors.white,
+        elevation: 0,
+        title: Text(widget.name,
+            style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w800, fontFamily: 'monospace')),
+        actions: [
+          IconButton(onPressed: _edit, icon: const Icon(Icons.edit_outlined, size: 19, color: AppColors.brand)),
+          IconButton(
+            onPressed: () {
+              ref.read(chatRefsProvider.notifier).add(ChatRef(
+                    type: 'file',
+                    name: widget.name,
+                    detail: widget.path,
+                  ));
+              Navigator.of(context).pop();
+              ScaffoldMessenger.of(context)
+                  .showSnackBar(const SnackBar(content: Text('已发到对话')));
+            },
+            icon: const Icon(Icons.arrow_outward_rounded, size: 19, color: AppColors.brand),
+          ),
+        ],
+      ),
+      body: _loading
+          ? const Center(child: CircularProgressIndicator())
+          : SingleChildScrollView(
+              padding: const EdgeInsets.all(16),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text(widget.path,
+                      style: const TextStyle(fontSize: 9, color: AppColors.muted, fontFamily: 'monospace')),
+                  const SizedBox(height: 10),
+                  Container(
+                    width: double.infinity,
+                    padding: const EdgeInsets.all(12),
+                    decoration: BoxDecoration(color: const Color(0xFF0B1220), borderRadius: BorderRadius.circular(10)),
+                    child: SelectableText(
+                      _content ?? '',
+                      style: const TextStyle(fontSize: 10.5, fontFamily: 'monospace', color: Color(0xFFCBD5E1), height: 1.7),
+                    ),
+                  ),
+                  if (_runnable) ...[
+                    const SizedBox(height: 14),
+                    GlassCard(
+                      onTap: _run,
+                      child: Row(
+                        children: const [
+                          Icon(Icons.play_arrow_rounded, size: 18, color: AppColors.brand),
+                          SizedBox(width: 10),
+                          Expanded(child: Text('运行', style: TextStyle(fontSize: 13))),
+                        ],
+                      ),
+                    ),
+                  ],
+                  const SizedBox(height: 12),
+                  Text(
+                    _runnable
+                        ? '可运行：用 sh 执行。点右上角可以编辑或交给 AI。'
+                        : '这个格式不直接执行，可以编辑、或交给 AI 处理。',
+                    style: const TextStyle(fontSize: 10.5, color: AppColors.muted, height: 1.7),
+                  ),
+                ],
+              ),
+            ),
+    );
+  }
+}
