-class _Row {
-  final String time;
-  final String host;
-  final String ips;
-  _Row(this.time, this.host, this.ips);
-
-  static _Row? parse(String line) {
-    // 格式：<毫秒时间戳> <域名> -> <ip,ip>
-    final idx = line.indexOf(' ');
-    if (idx <= 0) return null;
-    final ts = int.tryParse(line.substring(0, idx));
-    final rest = line.substring(idx + 1);
-    final arrow = rest.indexOf(' -> ');
-    if (arrow <= 0) return null;
-    final host = rest.substring(0, arrow).trim();
-    final ipText = rest.substring(arrow + 4).trim();
-    final t = ts == null ? '' : _fmt(ts);
-    return _Row(t, host, ipText == '?' ? '' : ipText);
-  }
-
-  static String _fmt(int ms) {
-    final d = DateTime.fromMillisecondsSinceEpoch(ms);
-    String two(int v) => v.toString().padLeft(2, '0');
-    return '${two(d.hour)}:${two(d.minute)}:${two(d.second)}';
-  }
-}
